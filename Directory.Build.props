<Project>

  <!--
    Gemeinsame Build-Einstellungen fuer alle Projekte der Fuhrparkmanagement-Solution.
    Entwickelt durch LSP Virtual Services.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8618;CS8625</WarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Erlaubt das Kompilieren der WPF-Projekte auch auf Build-Agents ohne Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Produkt- und Herstellerangaben (Executable Metadata). -->
  <PropertyGroup>
    <Company>LSP Virtual Services</Company>
    <Authors>LSP Virtual Services</Authors>
    <Product>Fuhrparkmanagement</Product>
    <Copyright>© LSP Virtual Services</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
