<UserControl x:Class="Fuhrpark.Client.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="_Backup jetzt erstellen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="190"
                Command="{Binding CreateBackupCommand}" />
        <Button Content="Sicherung _prüfen" Margin="8,0,0,0" Command="{Binding VerifyCommand}" MinWidth="150" />
        <Button Content="_Wiederherstellung" Margin="8,0,0,0" Command="{Binding ShowRestoreInstructionsCommand}"
                MinWidth="160" />
        <Button Content="Backup_ordner öffnen" Margin="8,0,0,0" Command="{Binding OpenBackupFolderCommand}"
                MinWidth="170" />
        <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Border>

    <UniformGrid Grid.Row="1" Columns="3" Margin="12,12,12,0">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="LETZTE ERFOLGREICHE SICHERUNG" Style="{StaticResource FieldLabelStyle}" />
          <TextBlock Text="{Binding LastSuccessful, TargetNullValue='noch keine vorhanden'}" FontSize="15"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="BACKUPVERZEICHNIS" Style="{StaticResource FieldLabelStyle}" />
          <TextBlock Text="{Binding BackupDirectory, TargetNullValue='nicht konfiguriert'}" FontSize="13"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="AUFBEWAHRUNG" Style="{StaticResource FieldLabelStyle}" />
          <TextBlock Text="{Binding RetentionRecommendation}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"
                     TextWrapping="Wrap"
                     Visibility="{Binding ProgressText, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <DataGrid Grid.Row="2" Margin="12" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedBackup}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Gestartet" Binding="{Binding StartedAt, StringFormat=dd.MM.yyyy HH:mm:ss}"
                            Width="170" />
        <DataGridTextColumn Header="Beendet" Binding="{Binding FinishedAt, StringFormat=dd.MM.yyyy HH:mm:ss}"
                            Width="170" />
        <DataGridTextColumn Header="Art" Binding="{Binding Kind}" Width="120" />
        <DataGridTemplateColumn Header="Status" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border>
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
                    <Setter Property="Background" Value="{StaticResource OkBackgroundBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                        <Setter Property="Background" Value="{StaticResource CriticalBackgroundBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock FontSize="11">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                      <Setter Property="Text" Value="erfolgreich" />
                      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                          <Setter Property="Text" Value="fehlgeschlagen" />
                          <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Geprüft" Binding="{Binding IsVerified, Converter={StaticResource BoolToYesNo}}"
                            Width="90" />
        <DataGridTextColumn Header="Größe" Binding="{Binding SizeBytes, Converter={StaticResource FileSize}}"
                            Width="110" />
        <DataGridTextColumn Header="Ausgelöst von" Binding="{Binding TriggeredBy}" Width="150" />
        <DataGridTextColumn Header="Datei" Binding="{Binding FilePath}" Width="*" />
        <DataGridTextColumn Header="Fehler" Binding="{Binding ErrorMessage}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
