<UserControl x:Class="Fuhrpark.Client.Views.Dialogs.ChangePasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
    </Border>

    <StackPanel Grid.Row="1" Margin="18">
      <TextBlock Text="Aktuelles Passwort" Style="{StaticResource FieldLabelStyle}" />
      <PasswordBox x:Name="CurrentPasswordBox" PasswordChanged="OnCurrentPasswordChanged" />

      <TextBlock Text="Neues Passwort" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged" />

      <TextBlock Text="Neues Passwort wiederholen" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <PasswordBox x:Name="RepeatPasswordBox" PasswordChanged="OnRepeatPasswordChanged" />

      <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                 Text="Das Passwort muss die in den Einstellungen hinterlegte Mindestlänge erfüllen und mindestens einen Buchstaben sowie eine Ziffer enthalten." />
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Ändern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
