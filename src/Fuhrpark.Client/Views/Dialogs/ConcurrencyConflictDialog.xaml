<Window x:Class="Fuhrpark.Client.Views.Dialogs.ConcurrencyConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datensatz wurde geändert" Height="340" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}" ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource PageTitleStyle}" Foreground="{StaticResource WarnBrush}"
               Text="Dieser Datensatz wurde zwischenzeitlich geändert" />

    <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Dieser Datensatz wurde zwischenzeitlich von einem anderen Benutzer geändert." />

    <Border x:Name="DifferencePanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed"
            Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceSunkenBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="DifferenceText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="_Aktuelle Daten laden" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160"
              Click="OnReload" Margin="0,0,8,0" />
      <Button Content="Änderungen _vergleichen" MinWidth="160" Click="OnCompare" Margin="0,0,8,0" />
      <Button Content="Abbre_chen" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
