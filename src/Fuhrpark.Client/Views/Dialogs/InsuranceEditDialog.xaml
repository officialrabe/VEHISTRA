<UserControl x:Class="Fuhrpark.Client.Views.Dialogs.InsuranceEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Versicherung *" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Versicherungsart" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
            <CheckBox Content="Vertrag ist aktiv" IsChecked="{Binding IsActive}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Versicherungsnummer" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding PolicyNumber, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Vertragsnummer" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding ContractNumber, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Beginn" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding ValidFrom}" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Text="Ende" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding ValidTo}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Ansprechpartner" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="E-Mail" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Jahresprämie (EUR)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding AnnualPremium, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="SB Vollkasko (EUR)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding DeductibleComprehensive, UpdateSourceTrigger=PropertyChanged,
                                    TargetNullValue=''}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="SB Teilkasko (EUR)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding DeductiblePartial, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
