<UserControl x:Class="Fuhrpark.Client.Views.Dialogs.LicensePlateEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="640">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Kennzeichen *" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Plate, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                     MaxLength="16" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding StatusValues}" SelectedItem="{Binding Status}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Zulassungsstelle" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RegistrationOffice, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <CheckBox Content="Saisonkennzeichen" IsChecked="{Binding IsSeasonPlate}" Margin="0,14,0,0" />

        <Grid Margin="0,8,0,0" IsEnabled="{Binding IsSeasonPlate}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Saison von (MM)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding SeasonFrom, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Saison bis (MM)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding SeasonTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
