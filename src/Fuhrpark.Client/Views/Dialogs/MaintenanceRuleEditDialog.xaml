<UserControl x:Class="Fuhrpark.Client.Views.Dialogs.MaintenanceRuleEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <TextBlock Text="Bezeichnung *" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="54"
                 AcceptsReturn="True" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Intervallart" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding IntervalTypes}" SelectedItem="{Binding IntervalType}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Intervall (Monate)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IntervalMonths, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Intervall (km)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding IntervalKilometers, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Vorwarnung (Tage)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding WarnDaysBefore, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Vorwarnung (km)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding WarnKilometersBefore, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Nur für Kategorie (optional)" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Name" />
          </StackPanel>
        </Grid>

        <CheckBox Content="Regel ist aktiv" IsChecked="{Binding IsActive}" Margin="0,14,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
