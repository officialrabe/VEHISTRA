<UserControl x:Class="Fuhrpark.Client.Views.Dialogs.MileageEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding VehicleDisplay}" Style="{StaticResource PageSubtitleStyle}" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="18">
      <Border Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceSunkenBrush}"
              Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="AKTUELLER STAND" Style="{StaticResource FieldLabelStyle}" />
          <TextBlock FontSize="19" FontWeight="SemiBold">
            <Run Text="{Binding CurrentMileage, Mode=OneWay, StringFormat=N0}" /><Run Text=" km" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Neuer Kilometerstand *" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding NewMileage, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Erfasst am" Style="{StaticResource FieldLabelStyle}" />
          <DatePicker SelectedDate="{Binding RecordedAt}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Quelle" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <CheckBox Content="Als Korrektur kennzeichnen (erlaubt einen niedrigeren Wert)"
                IsChecked="{Binding IsCorrection}" Margin="0,12,0,0" />

      <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
               TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
