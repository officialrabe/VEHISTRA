<UserControl x:Class="Fuhrpark.Client.Views.Dialogs.RetirementEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <Border Style="{StaticResource CardStyle}" Background="{StaticResource InfoBackgroundBrush}"
                BorderBrush="{StaticResource InfoBrush}" Margin="0,0,0,14">
          <TextBlock TextWrapping="Wrap"
                     Text="Das Fahrzeug wird nicht gelöscht. Alle Schäden, Unfälle, Werkstattvorgänge sowie Fahrer- und Kennzeichenhistorien bleiben dauerhaft erhalten." />
        </Border>

        <TextBlock Text="{Binding VehicleDisplay}" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Ausgemustert am *" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding RetiredAt}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Grund *" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Letzter Kilometerstand" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding LastMileage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Grund (Freitext)" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" />

        <GroupBox Header="Abmeldung" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox Content="Fahrzeug ist abgemeldet" IsChecked="{Binding IsDeregistered}"
                      VerticalAlignment="Bottom" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="Abmeldedatum" Style="{StaticResource FieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding DeregisteredAt}" IsEnabled="{Binding IsDeregistered}" />
            </StackPanel>
            <CheckBox Grid.Column="4" Content="Kennzeichen entfernt" IsChecked="{Binding LicensePlateRemoved}"
                      VerticalAlignment="Bottom" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Verbleib des Fahrzeugs">
          <StackPanel>
            <WrapPanel>
              <CheckBox Content="Verkauft" IsChecked="{Binding IsSold}" Margin="0,0,20,0" />
              <CheckBox Content="Verschrottet" IsChecked="{Binding IsScrapped}" Margin="0,0,20,0" />
              <CheckBox Content="Totalschaden" IsChecked="{Binding IsTotalLoss}" Margin="0,0,20,0" />
              <CheckBox Content="Leasingrückgabe" IsChecked="{Binding IsLeasingReturn}" Margin="0,0,20,0" />
              <CheckBox Content="Ersatzteilspender" IsChecked="{Binding IsSparePartDonor}" />
            </WrapPanel>

            <Grid Margin="0,12,0,0" IsEnabled="{Binding IsSold}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Verkaufspreis (EUR)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Käufer" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Buyer, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </GroupBox>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Ausmustern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
