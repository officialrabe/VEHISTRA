<UserControl x:Class="Fuhrpark.Client.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="_Dokument hinzufügen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170"
                  Command="{Binding AddCommand}"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="_Öffnen" Margin="8,0,0,0" Command="{Binding OpenCommand}" />
          <Button Content="_Archivieren" Margin="8,0,0,0" Command="{Binding ArchiveCommand}"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="_Fahrzeugakte" Margin="8,0,0,0" Command="{Binding OpenVehicleCommand}" />
          <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
          <Button Content="Ablage im Explorer öffnen" Command="{Binding OpenStorageFolderCommand}" MinWidth="190" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBox Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   ToolTip="Suche nach Titel, Dateiname oder Beschreibung" />
          <ComboBox Width="190" Margin="8,0,0,0" ItemsSource="{Binding CategoryValues}"
                    SelectedItem="{Binding CategoryFilter}" ToolTip="Kategorie">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="DocumentGrid" Grid.Row="1" Margin="12" ItemsSource="{Binding Documents}"
              SelectedItem="{Binding SelectedDocument}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}"
                      CommandParameter="{Binding SelectedItem, ElementName=DocumentGrid}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Kategorie" Binding="{Binding Category, Converter={StaticResource EnumToText}}"
                            Width="170" />
        <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold" />
        <DataGridTextColumn Header="Fahrzeug" Binding="{Binding VehicleDisplay}" Width="150" />
        <DataGridTextColumn Header="Dateiname" Binding="{Binding OriginalFileName}" Width="2*" />
        <DataGridTextColumn Header="Größe" Binding="{Binding FileSizeBytes, Converter={StaticResource FileSize}}"
                            Width="100" />
        <DataGridTextColumn Header="Dokumentdatum" Binding="{Binding DocumentDate, StringFormat=dd.MM.yyyy}"
                            Width="140" />
        <DataGridTextColumn Header="Hinzugefügt am" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                            Width="150" />
        <DataGridTextColumn Header="Hinzugefügt von" Binding="{Binding CreatedBy}" Width="170" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
