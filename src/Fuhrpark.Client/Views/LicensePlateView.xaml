<UserControl x:Class="Fuhrpark.Client.Views.LicensePlateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="_Neues Kennzeichen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="160"
                  Command="{Binding CreateCommand}"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="_Bearbeiten" Margin="8,0,0,0" Command="{Binding EditCommand}"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="_Reservieren" Margin="8,0,0,0" Command="{Binding ReserveCommand}"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Vom Fahrzeug _lösen" Margin="8,0,0,0" Command="{Binding ReleaseFromVehicleCommand}"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="_Fahrzeugakte" Margin="8,0,0,0" Command="{Binding OpenVehicleCommand}" />
          <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
          <Button Content="_Importieren" Command="{Binding ImportCommand}"
                  Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Export CSV" Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="csv"
                  Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   ToolTip="Kennzeichen suchen" />
          <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding StatusValues}"
                    SelectedItem="{Binding StatusFilter}" ToolTip="Status">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <DataGrid ItemsSource="{Binding Plates}" SelectedItem="{Binding SelectedPlate}">
        <DataGrid.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Kennzeichen" Binding="{Binding Plate}" Width="150" FontWeight="SemiBold" />
          <DataGridTemplateColumn Header="Status" Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource BadgeStyle}"
                        Background="{Binding Status, Converter={StaticResource PlateStatusToBackground}}">
                  <TextBlock Text="{Binding Status, Converter={StaticResource EnumToText}}" FontSize="11"
                             Foreground="{Binding Status, Converter={StaticResource PlateStatusToBrush}}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Aktuelles Fahrzeug" Binding="{Binding CurrentVehicleDisplay}" Width="*" />
          <DataGridTextColumn Header="Reserviert bis" Binding="{Binding ReservedUntil, StringFormat=dd.MM.yyyy}"
                              Width="130" />
          <DataGridTemplateColumn Header="Reservierung" Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource BadgeStyle}"
                        Background="{Binding ReservationWarning, Converter={StaticResource WarningLevelToBackground}}"
                        Visibility="{Binding ReservedUntil, Converter={StaticResource NullToVisibility}}">
                  <TextBlock FontSize="11"
                             Foreground="{Binding ReservationWarning, Converter={StaticResource WarningLevelToBrush}}">
                    <Run Text="{Binding DaysUntilReservationExpires, Mode=OneWay}" /><Run Text=" Tage" />
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Bemerkung" Binding="{Binding Comment}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ToolbarStyle}">
              <TextBlock Text="LAUFENDE RESERVIERUNGEN" FontWeight="SemiBold" FontSize="11" />
            </Border>
            <DataGrid x:Name="ReservationGrid" Grid.Row="1" ItemsSource="{Binding Reservations}"
                      BorderThickness="0">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Reservierung aufheben"
                            Command="{Binding PlacementTarget.DataContext.ReleaseReservationCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding SelectedItem, ElementName=ReservationGrid}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Kennzeichen" Binding="{Binding LicensePlate.Plate}" Width="*" />
                <DataGridTextColumn Header="Reserviert bis" Binding="{Binding ReservedUntil, StringFormat=dd.MM.yyyy}"
                                    Width="120" />
                <DataGridTextColumn Header="Nummer" Binding="{Binding ReservationNumber}" Width="130" />
                <DataGridTextColumn Header="Zulassungsstelle" Binding="{Binding RegistrationOffice}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ToolbarStyle}">
              <TextBlock Text="HISTORIE DES AUSGEWÄHLTEN KENNZEICHENS" FontWeight="SemiBold" FontSize="11" />
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding History}" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fahrzeug" Binding="{Binding Vehicle.DisplayName}" Width="*" />
                <DataGridTextColumn Header="Von" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="100" />
                <DataGridTextColumn Header="Bis" Binding="{Binding ValidTo, StringFormat=dd.MM.yyyy,
                                                           TargetNullValue='aktuell'}" Width="100" />
                <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
