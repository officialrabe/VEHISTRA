<Window x:Class="Fuhrpark.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Fuhrpark.Client.Converters"
        Title="Anmeldung – Fuhrparkmanagement" Height="470" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
  <Window.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Markenbereich -->
    <Border Background="{StaticResource SidebarBrush}">
      <Grid Margin="26,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="FUHRPARK" FontSize="24" FontWeight="Light"
                     Foreground="{StaticResource TextInvertedBrush}" />
          <TextBlock Text="MANAGEMENT" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource TextInvertedBrush}" Margin="0,-6,0,0" />
          <Border Background="{StaticResource SidebarActiveBrush}" Height="3" Width="60"
                  HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock x:Name="CompanyText" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource SidebarTextBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="ServerText" FontSize="11" Margin="0,8,0,0"
                     Foreground="{StaticResource SidebarSectionBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Developed by LSP Virtual Services" FontSize="11"
                   Foreground="{StaticResource SidebarSectionBrush}" />
      </Grid>
    </Border>

    <!-- Anmeldeformular -->
    <Grid Grid.Column="1" Margin="40,34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Anmeldung" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Bitte melden Sie sich mit Ihrem Benutzerkonto an."
                   Style="{StaticResource PageSubtitleStyle}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,24,0,0">
        <TextBlock Text="Benutzername" Style="{StaticResource FieldLabelStyle}" />
        <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="64" TabIndex="0" />

        <TextBlock Text="Passwort" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,2" />
        <PasswordBox x:Name="PasswordBox" TabIndex="1" PasswordChanged="OnPasswordChanged" />

        <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="3"
                Background="{StaticResource CriticalBackgroundBrush}"
                BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0"
                       Foreground="{StaticResource CriticalBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="330"
                       Foreground="{StaticResource CriticalBrush}" />
          </StackPanel>
        </Border>

        <ProgressBar Margin="0,14,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button Content="_Anmelden" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"
                  IsDefault="True" TabIndex="2" Command="{Binding LoginCommand}" />
          <Button Content="_Beenden" Margin="10,0,0,0" TabIndex="3" Command="{Binding ExitCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="3" Orientation="Horizontal">
        <Button Content="Servereinstellungen" Style="{StaticResource LinkButtonStyle}"
                Command="{Binding OpenServerSettingsCommand}" />
        <TextBlock Text="·" Margin="6,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}" />
        <TextBlock x:Name="VersionText" VerticalAlignment="Center" Style="{StaticResource PageSubtitleStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
