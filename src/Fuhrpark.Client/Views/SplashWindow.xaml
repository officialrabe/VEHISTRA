<Window x:Class="Fuhrpark.Client.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuhrparkmanagement" Height="240" Width="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="{StaticResource SidebarBrush}">
  <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
    <Grid Margin="30,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="FUHRPARKMANAGEMENT" FontSize="21" FontWeight="SemiBold"
                 Foreground="{StaticResource TextInvertedBrush}" />

      <TextBlock Grid.Row="1" x:Name="VersionText" Margin="0,4,0,0" FontSize="12"
                 Foreground="{StaticResource SidebarSectionBrush}" Text="Version 1.0.0" />

      <TextBlock Grid.Row="2" x:Name="StatusText" VerticalAlignment="Center" FontSize="13"
                 Foreground="{StaticResource SidebarTextBrush}"
                 Text="Verbindung zum Server wird hergestellt ..." />

      <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3" Margin="0,0,0,14" />

      <TextBlock Grid.Row="4" Text="Developed by LSP Virtual Services" FontSize="11"
                 Foreground="{StaticResource SidebarSectionBrush}" />
    </Grid>
  </Border>
</Window>
