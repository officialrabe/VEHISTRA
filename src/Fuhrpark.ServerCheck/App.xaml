<Application x:Class="Fuhrpark.ServerCheck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fuhrpark.ServerCheck"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <local:CheckStateBrushConverter x:Key="StateBrush" />
    <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:TextToVisibilityConverter x:Key="TextVisibility" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF1F2A37" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0D6EFD" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1C2430" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF5E6B79" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD3D9DE" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFF4F6F8" />

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="MinWidth" Value="130" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
