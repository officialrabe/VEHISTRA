<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fuhrpark.Updater</RootNamespace>
    <AssemblyName>FuhrparkManager.Updater</AssemblyName>
    <AssemblyTitle>Fuhrparkmanagement Updater</AssemblyTitle>
    <Description>Update-Komponente fuer das Fuhrparkmanagement. Entwickelt von LSP Virtual Services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fuhrpark.Domain\Fuhrpark.Domain.csproj" />
    <ProjectReference Include="..\Fuhrpark.Application\Fuhrpark.Application.csproj" />
    <ProjectReference Include="..\Fuhrpark.Infrastructure\Fuhrpark.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
