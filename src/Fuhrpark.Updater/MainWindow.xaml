<Window x:Class="Fuhrpark.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuhrparkmanagement – Update" Height="520" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource SurfaceBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource SidebarBrush}" Padding="26,20">
      <StackPanel>
        <TextBlock Text="FUHRPARKMANAGEMENT" FontSize="18" FontWeight="SemiBold" Foreground="White" />
        <TextBlock x:Name="SubtitleText" Text="Programm- und Datenbankupdate" FontSize="12"
                   Foreground="#FFB9C4D0" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="26,20,26,0">
      <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                 Text="Das Update kann jetzt gestartet werden." />
      <ProgressBar x:Name="Progress" Height="6" Margin="0,14,0,0" Maximum="6" Value="0" />
    </StackPanel>

    <Border Grid.Row="2" Margin="26,16,26,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="#FFF4F6F8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontFamily="Consolas" FontSize="11" Padding="12" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <Border Grid.Row="3" Background="#FFF4F6F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="26,14" Margin="0,16,0,0">
      <Grid>
        <TextBlock Text="Developed by LSP Virtual Services" VerticalAlignment="Center" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="StartButton" Content="_Update starten" Click="OnStart" MinWidth="150"
                  Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
          <Button x:Name="CloseButton" Content="_Schließen" Margin="8,0,0,0" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
