<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Farbpalette der Anwendung.
    Farbe ist niemals die alleinige Information - Status werden zusaetzlich
    immer mit Text und Symbol dargestellt.
  -->

  <!-- Grundflaechen -->
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceAltColor">#FFF4F6F8</Color>
  <Color x:Key="SurfaceSunkenColor">#FFECEFF1</Color>
  <Color x:Key="BorderColor">#FFD3D9DE</Color>
  <Color x:Key="BorderStrongColor">#FFB0BAC3</Color>

  <!-- Text -->
  <Color x:Key="TextColor">#FF1C2430</Color>
  <Color x:Key="TextMutedColor">#FF5E6B79</Color>
  <Color x:Key="TextInvertedColor">#FFFFFFFF</Color>

  <!-- Navigation -->
  <Color x:Key="SidebarColor">#FF1F2A37</Color>
  <Color x:Key="SidebarHoverColor">#FF2C3A4A</Color>
  <Color x:Key="SidebarActiveColor">#FF0D6EFD</Color>
  <Color x:Key="SidebarTextColor">#FFD6DEE8</Color>
  <Color x:Key="SidebarSectionColor">#FF8A97A6</Color>

  <!-- Akzente -->
  <Color x:Key="AccentColor">#FF0D6EFD</Color>
  <Color x:Key="AccentHoverColor">#FF0B5ED7</Color>
  <Color x:Key="AccentPressedColor">#FF0A58CA</Color>

  <!-- Statusfarben -->
  <Color x:Key="OkColor">#FF2E7D32</Color>
  <Color x:Key="OkBackgroundColor">#FFE6F4EA</Color>
  <Color x:Key="InfoColor">#FFF9A825</Color>
  <Color x:Key="InfoBackgroundColor">#FFFFF8E1</Color>
  <Color x:Key="WarnColor">#FFEF6C00</Color>
  <Color x:Key="WarnBackgroundColor">#FFFFF0E1</Color>
  <Color x:Key="CriticalColor">#FFC62828</Color>
  <Color x:Key="CriticalBackgroundColor">#FFFDECEA</Color>
  <Color x:Key="InactiveColor">#FF616161</Color>
  <Color x:Key="InactiveBackgroundColor">#FFEEEEEE</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextInvertedBrush" Color="{StaticResource TextInvertedColor}" />

  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
  <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
  <SolidColorBrush x:Key="SidebarSectionBrush" Color="{StaticResource SidebarSectionColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="OkBackgroundBrush" Color="{StaticResource OkBackgroundColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoBackgroundColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="WarnBackgroundBrush" Color="{StaticResource WarnBackgroundColor}" />
  <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
  <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="{StaticResource CriticalBackgroundColor}" />
  <SolidColorBrush x:Key="InactiveBrush" Color="{StaticResource InactiveColor}" />
  <SolidColorBrush x:Key="InactiveBackgroundBrush" Color="{StaticResource InactiveBackgroundColor}" />

  <!-- Typografie -->
  <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
  <sys:Double x:Key="FontSizeSmall">11</sys:Double>
  <sys:Double x:Key="FontSizeNormal">13</sys:Double>
  <sys:Double x:Key="FontSizeMedium">15</sys:Double>
  <sys:Double x:Key="FontSizeLarge">19</sys:Double>
  <sys:Double x:Key="FontSizeHuge">26</sys:Double>

</ResourceDictionary>
