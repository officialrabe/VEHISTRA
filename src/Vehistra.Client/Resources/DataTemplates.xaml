<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Vehistra.Client.Converters"
                    xmlns:vm="clr-namespace:Vehistra.Client.ViewModels"
                    xmlns:dvm="clr-namespace:Vehistra.Client.ViewModels.Dialogs"
                    xmlns:views="clr-namespace:Vehistra.Client.Views"
                    xmlns:dialogs="clr-namespace:Vehistra.Client.Views.Dialogs">

  <!-- Wertkonverter -->
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:WarningLevelToBrushConverter x:Key="WarningLevelToBrush" />
  <conv:WarningLevelToBrushConverter x:Key="WarningLevelToBackground" Background="True" />
  <conv:WarningLevelToTextConverter x:Key="WarningLevelToText" />
  <conv:HexToBrushConverter x:Key="HexToBrush" />
  <conv:EnumToTextConverter x:Key="EnumToText" />
  <conv:FileSizeConverter x:Key="FileSize" />
  <conv:CountToVisibilityConverter x:Key="NotificationCountConverter" />
  <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
  <conv:SeverityToBrushConverter x:Key="SeverityToBackgroundConverter" Background="True" />
  <conv:DamageStatusToBrushConverter x:Key="DamageStatusToBrush" />
  <conv:DamageStatusToBrushConverter x:Key="DamageStatusToBackground" Background="True" />
  <conv:DamagePriorityToBrushConverter x:Key="DamagePriorityToBrush" />
  <conv:DamagePriorityToBrushConverter x:Key="DamagePriorityToBackground" Background="True" />
  <conv:WorkshopStatusToBrushConverter x:Key="WorkshopStatusToBrush" />
  <conv:WorkshopStatusToBrushConverter x:Key="WorkshopStatusToBackground" Background="True" />
  <conv:PlateStatusToBrushConverter x:Key="PlateStatusToBrush" />
  <conv:PlateStatusToBrushConverter x:Key="PlateStatusToBackground" Background="True" />
  <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />
  <conv:InverseBooleanConverter x:Key="InverseBool" />

  <!-- Zuordnung Ansichtsmodell zu Ansicht -->
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <views:DashboardView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:VehicleListViewModel}">
    <views:VehicleListView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:VehicleDetailViewModel}">
    <views:VehicleDetailView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DriverViewModel}">
    <views:DriverView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:InspectionViewModel}">
    <views:InspectionView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
    <views:MaintenanceView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DamageViewModel}">
    <views:DamageView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AccidentViewModel}">
    <views:AccidentView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:WorkshopViewModel}">
    <views:WorkshopView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:LicensePlateViewModel}">
    <views:LicensePlateView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RetiredVehiclesViewModel}">
    <views:RetiredVehiclesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
    <views:DocumentsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
    <views:ReportsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:UsersViewModel}">
    <views:UsersView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RolesViewModel}">
    <views:RolesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AuditViewModel}">
    <views:AuditView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:BackupViewModel}">
    <views:BackupView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
    <views:UpdatesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <views:SettingsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SupportViewModel}">
    <views:SupportView />
  </DataTemplate>

  <!-- Dialoge -->
  <DataTemplate DataType="{x:Type dvm:VehicleEditViewModel}">
    <dialogs:VehicleEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:DriverEditViewModel}">
    <dialogs:DriverEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:DamageEditViewModel}">
    <dialogs:DamageEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:AccidentEditViewModel}">
    <dialogs:AccidentEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:WorkshopOrderEditViewModel}">
    <dialogs:WorkshopOrderEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:InspectionEditViewModel}">
    <dialogs:InspectionEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:MaintenanceEntryEditViewModel}">
    <dialogs:MaintenanceEntryEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:MaintenanceRuleEditViewModel}">
    <dialogs:MaintenanceRuleEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:LicensePlateEditViewModel}">
    <dialogs:LicensePlateEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:ReservationEditViewModel}">
    <dialogs:ReservationEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:RetirementEditViewModel}">
    <dialogs:RetirementEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:MileageEditViewModel}">
    <dialogs:MileageEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:UserEditViewModel}">
    <dialogs:UserEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:RoleEditViewModel}">
    <dialogs:RoleEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:ChangePasswordViewModel}">
    <dialogs:ChangePasswordDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:InsuranceEditViewModel}">
    <dialogs:InsuranceEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:VehicleKeyEditViewModel}">
    <dialogs:VehicleKeyEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:StatusChangeViewModel}">
    <dialogs:StatusChangeDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:DocumentUploadViewModel}">
    <dialogs:DocumentUploadDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:ImportWizardViewModel}">
    <dialogs:ImportWizardDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:RegistrationEditViewModel}">
    <dialogs:RegistrationEditDialog />
  </DataTemplate>

  <DataTemplate DataType="{x:Type dvm:DriverAssignmentViewModel}">
    <dialogs:DriverAssignmentDialog />
  </DataTemplate>

</ResourceDictionary>
