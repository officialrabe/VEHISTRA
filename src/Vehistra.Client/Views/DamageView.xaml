<UserControl x:Class="Vehistra.Client.Views.DamageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="_Schaden melden" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140"
                Command="{Binding CreateCommand}"
                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="_Bearbeiten" Margin="8,0,0,0" Command="{Binding EditCommand}"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="_Abschließen" Margin="8,0,0,0" Command="{Binding CloseDamageCommand}"
                Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="_Fahrzeugakte" Margin="8,0,0,0" Command="{Binding OpenVehicleCommand}" />
        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
        <Button Content="Export CSV" Command="{Binding ExportCommand}" CommandParameter="csv"
                Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Export XLSX" Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="xlsx"
                Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="12,8">
      <StackPanel Orientation="Horizontal">
        <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                 ToolTip="Suche nach Schadensnummer, Beschreibung oder Fahrzeug" />
        <ComboBox Width="160" Margin="8,0,0,0" ItemsSource="{Binding StatusValues}"
                  SelectedItem="{Binding StatusFilter}" ToolTip="Status">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{Binding PriorityValues}"
                  SelectedItem="{Binding PriorityFilter}" ToolTip="Priorität">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                  SelectedItem="{Binding CategoryFilter}" ToolTip="Kategorie" />
        <CheckBox Content="nur offene" IsChecked="{Binding OnlyOpen}" Margin="14,0,0,0" VerticalAlignment="Center" />
        <CheckBox Content="nicht fahrbereit" IsChecked="{Binding OnlyNotDriveable}" Margin="14,0,0,0"
                  VerticalAlignment="Center" />
        <CheckBox Content="Versicherungsfälle" IsChecked="{Binding OnlyInsuranceCases}" Margin="14,0,0,0"
                  VerticalAlignment="Center" />
        <Button Content="Filter _zurücksetzen" Margin="14,0,0,0" Command="{Binding ResetFilterCommand}" />
      </StackPanel>
    </Border>

    <DataGrid x:Name="DamageGrid" Grid.Row="2" Margin="12" ItemsSource="{Binding Damages}"
              SelectedItem="{Binding SelectedDamage}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"
                      CommandParameter="{Binding SelectedItem, ElementName=DamageGrid}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Schadensnummer" Binding="{Binding DamageNumber}" Width="140"
                            FontWeight="SemiBold" />
        <DataGridTextColumn Header="Fahrzeug" Binding="{Binding VehicleDisplay}" Width="*" />
        <DataGridTextColumn Header="Fahrer" Binding="{Binding DriverName}" Width="160" />
        <DataGridTextColumn Header="Datum" Binding="{Binding OccurredAt, StringFormat=dd.MM.yyyy}" Width="110" />
        <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2*" />
        <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryName}" Width="130" />
        <DataGridTemplateColumn Header="Priorität" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Style="{StaticResource BadgeStyle}"
                      Background="{Binding Priority, Converter={StaticResource DamagePriorityToBackground}}">
                <TextBlock Text="{Binding Priority, Converter={StaticResource EnumToText}}" FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding Priority, Converter={StaticResource DamagePriorityToBrush}}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Status" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Style="{StaticResource BadgeStyle}"
                      Background="{Binding Status, Converter={StaticResource DamageStatusToBackground}}">
                <TextBlock Text="{Binding Status, Converter={StaticResource EnumToText}}" FontSize="11"
                           Foreground="{Binding Status, Converter={StaticResource DamageStatusToBrush}}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Fahrbereit" Binding="{Binding IsDriveable, Converter={StaticResource BoolToYesNo}}"
                            Width="100" />
        <DataGridTextColumn Header="Kosten" Binding="{Binding CostActual, Converter={StaticResource Waehrung}}" Width="110" />
        <DataGridTextColumn Header="Versicherung"
                            Binding="{Binding IsInsuranceCase, Converter={StaticResource BoolToYesNo}}" Width="110" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
