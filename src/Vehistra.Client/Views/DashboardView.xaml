<UserControl x:Class="Vehistra.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <UserControl.Resources>
    <!-- Kennzahl innerhalb einer Karte -->
    <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="MetricRowStyle" TargetType="Grid">
      <Setter Property="Margin" Value="0,3" />
    </Style>

    <!-- Anklickbare Zahl: sieht aus wie die Zahl daneben, reagiert aber auf
         Klick und Tastatur. Der Zeiger und der Hinweistext zeigen, dass es
         mehr als Text ist - nicht die Farbe allein. -->
    <Style x:Key="MetricLinkStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Inhalt" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                <Setter Property="TextBlock.TextDecorations" Value="Underline" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TextBlock.TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MetricTileLinkStyle" TargetType="Button" BasedOn="{StaticResource MetricLinkStyle}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="_Aktualisieren" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>

        <!-- Fahrzeugkennzahlen -->
        <UniformGrid Columns="5" Margin="0,0,0,14">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <Button Content="{Binding Data.Vehicles.Total}" Style="{StaticResource MetricTileLinkStyle}"
                      Command="{Binding OpenPresetCommand}" CommandParameter="AlleFahrzeuge"
                      ToolTip="Alle Fahrzeuge anzeigen" />
              <TextBlock Text="Fahrzeuge insgesamt" Style="{StaticResource MetricLabelStyle}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <Button Content="{Binding Data.Vehicles.Active}" Style="{StaticResource MetricTileLinkStyle}" Foreground="{StaticResource OkBrush}"
                      Command="{Binding OpenPresetCommand}" CommandParameter="AktiveFahrzeuge"
                      ToolTip="Angemeldete Fahrzeuge anzeigen" />
              <TextBlock Text="aktiv" Style="{StaticResource MetricLabelStyle}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <Button Content="{Binding Data.Vehicles.InWorkshop}" Style="{StaticResource MetricTileLinkStyle}" Foreground="{StaticResource WarnBrush}"
                      Command="{Binding OpenPresetCommand}" CommandParameter="FahrzeugeInWerkstatt"
                      ToolTip="Fahrzeuge in der Werkstatt anzeigen" />
              <TextBlock Text="in der Werkstatt" Style="{StaticResource MetricLabelStyle}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <Button Content="{Binding Data.Damages.Open}" Style="{StaticResource MetricTileLinkStyle}" Foreground="{StaticResource CriticalBrush}"
                      Command="{Binding OpenPresetCommand}" CommandParameter="OffeneSchaeden"
                      ToolTip="Offene Schäden anzeigen" />
              <TextBlock Text="offene Schäden" Style="{StaticResource MetricLabelStyle}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <Button Content="{Binding Data.Inspections.Expired}" Style="{StaticResource MetricTileLinkStyle}" Foreground="{StaticResource CriticalBrush}"
                      Command="{Binding OpenPresetCommand}" CommandParameter="TuevAbgelaufen"
                      ToolTip="Fahrzeuge mit abgelaufener Hauptuntersuchung anzeigen" />
              <TextBlock Text="TÜV abgelaufen" Style="{StaticResource MetricLabelStyle}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Detailbereiche -->
        <UniformGrid Columns="3">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,12">
            <StackPanel>
              <Grid>
                <TextBlock Text="FAHRZEUGE" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <Button Content="Öffnen" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding OpenVehiclesCommand}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="insgesamt" />
                <Button Content="{Binding Data.Vehicles.Total}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="AlleFahrzeuge"
                        ToolTip="Alle Fahrzeuge anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="aktiv" />
                <Button Content="{Binding Data.Vehicles.Active}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="AktiveFahrzeuge"
                        ToolTip="Angemeldete Fahrzeuge anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="verfügbar" />
                <TextBlock Text="{Binding Data.Vehicles.Available}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="im Einsatz" />
                <TextBlock Text="{Binding Data.Vehicles.InUse}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="ohne festen Fahrer" />
                <Button Content="{Binding Data.Vehicles.WithoutDriver}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="OhneFestenFahrer"
                        ToolTip="Fahrzeuge ohne festen Fahrer anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="Werkstatt" />
                <Button Content="{Binding Data.Vehicles.InWorkshop}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="FahrzeugeInWerkstatt"
                        ToolTip="Fahrzeuge in der Werkstatt anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="beschädigt" />
                <Button Content="{Binding Data.Vehicles.Damaged}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="FahrzeugeMitOffenenSchaeden"
                        ToolTip="Fahrzeuge mit offenen Schäden anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="nicht fahrbereit" />
                <TextBlock Text="{Binding Data.Vehicles.NotDriveable}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="abgemeldet" />
                <Button Content="{Binding Data.Vehicles.Deregistered}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="Abgemeldet"
                        ToolTip="Abgemeldete Fahrzeuge anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="ausgemustert" />
                <TextBlock Text="{Binding Data.Vehicles.Retired}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,12">
            <StackPanel>
              <Grid>
                <TextBlock Text="TÜV" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <Button Content="Öffnen" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding OpenInspectionsCommand}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="abgelaufen" />
                <Button Content="{Binding Data.Inspections.Expired}" Style="{StaticResource MetricLinkStyle}" Foreground="{StaticResource CriticalBrush}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="TuevAbgelaufen"
                        ToolTip="Fahrzeuge mit abgelaufener Hauptuntersuchung anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="innerhalb 7 Tage" />
                <TextBlock Text="{Binding Data.Inspections.Within7Days}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="innerhalb 14 Tage" />
                <Button Content="{Binding Data.Inspections.Within14Days}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="TuevIn14Tagen"
                        ToolTip="Fällig in 14 Tagen anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="innerhalb 30 Tage" />
                <Button Content="{Binding Data.Inspections.Within30Days}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="TuevIn30Tagen"
                        ToolTip="Fällig in 30 Tagen anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="innerhalb 60 Tage" />
                <Button Content="{Binding Data.Inspections.Within60Days}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="TuevIn60Tagen"
                        ToolTip="Fällig in 60 Tagen anzeigen" />
              </Grid>

              <Separator Margin="0,10" />

              <Grid>
                <TextBlock Text="WARTUNG" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <Button Content="Öffnen" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding OpenMaintenanceCommand}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="Service fällig" />
                <Button Content="{Binding Data.Maintenance.ServiceDue}" Style="{StaticResource MetricLinkStyle}" Foreground="{StaticResource CriticalBrush}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="WartungFaellig"
                        ToolTip="Fällige Wartungen anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="bald fällig" />
                <TextBlock Text="{Binding Data.Maintenance.ServiceDueSoon}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="Kilometerintervall erreicht" />
                <TextBlock Text="{Binding Data.Maintenance.MileageIntervalReached}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
              <Grid>
                <TextBlock Text="SCHÄDEN" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <Button Content="Öffnen" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding OpenDamagesCommand}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="offen" />
                <Button Content="{Binding Data.Damages.Open}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="OffeneSchaeden"
                        ToolTip="Offene Schäden anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="neu gemeldet" />
                <TextBlock Text="{Binding Data.Damages.New}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="kritisch" />
                <Button Content="{Binding Data.Damages.Critical}" Style="{StaticResource MetricLinkStyle}" Foreground="{StaticResource CriticalBrush}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="KritischeSchaeden"
                        ToolTip="Kritische Schäden anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="nicht fahrbereit" />
                <TextBlock Text="{Binding Data.Damages.NotDriveable}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" />
              </Grid>

              <Separator Margin="0,10" />

              <Grid>
                <TextBlock Text="WERKSTATT" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <Button Content="Öffnen" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding OpenWorkshopCommand}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="aktuell in Werkstatt" />
                <Button Content="{Binding Data.Workshop.CurrentlyInWorkshop}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="WerkstattHeute"
                        ToolTip="Fahrzeuge in der Werkstatt anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="Termin heute" />
                <TextBlock Text="{Binding Data.Workshop.AppointmentsToday}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="kommende Termine" />
                <TextBlock Text="{Binding Data.Workshop.UpcomingAppointments}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="überfällige Vorgänge" />
                <Button Content="{Binding Data.Workshop.Overdue}" Style="{StaticResource MetricLinkStyle}" Foreground="{StaticResource WarnBrush}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="WerkstattUeberfaellig"
                        ToolTip="Überfällige Werkstattvorgänge anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="{Binding Data.Workshop.LongStayWarnDays, StringFormat='lange dort (ab {0} Tagen)'}" />
                <Button Content="{Binding Data.Workshop.LongStay}" Style="{StaticResource MetricLinkStyle}" Foreground="{StaticResource WarnBrush}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="WerkstattLangzeit"
                        ToolTip="Fahrzeuge anzeigen, die ungewöhnlich lange in der Werkstatt stehen" />
              </Grid>

              <Separator Margin="0,10" />

              <Grid>
                <TextBlock Text="KENNZEICHEN" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <Button Content="Öffnen" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding OpenPlatesCommand}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="verfügbar" />
                <Button Content="{Binding Data.LicensePlates.Available}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="KennzeichenVerfuegbar"
                        ToolTip="Verfügbare Kennzeichen anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="reserviert" />
                <Button Content="{Binding Data.LicensePlates.Reserved}" Style="{StaticResource MetricLinkStyle}"
                        Command="{Binding OpenPresetCommand}" CommandParameter="KennzeichenReserviert"
                        ToolTip="Reservierte Kennzeichen anzeigen" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="Reservierung läuft bald ab" />
                <TextBlock Text="{Binding Data.LicensePlates.ReservationsExpiringSoon}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
              </Grid>
              <Grid Style="{StaticResource MetricRowStyle}">
                <TextBlock Text="Reservierung abgelaufen" />
                <TextBlock Text="{Binding Data.LicensePlates.ReservationsExpired}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" />
              </Grid>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Aufmerksamkeit erforderlich -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="AUFMERKSAMKEIT ERFORDERLICH" Style="{StaticResource SectionTitleStyle}" FontSize="12" />

            <TextBlock Text="Derzeit sind keine Vorgänge offen, die Aufmerksamkeit erfordern."
                       Margin="0,6,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding AttentionItems.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding AttentionItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button HorizontalContentAlignment="Stretch" BorderThickness="0,0,0,1" MinWidth="0"
                          BorderBrush="{StaticResource BorderBrush}" Background="Transparent" Padding="0,8"
                          Command="{Binding DataContext.OpenAttentionItemCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Width="4" Height="20" CornerRadius="2"
                              Background="{Binding Level, Converter={StaticResource WarningLevelToBrush}}" />

                      <Border Grid.Column="1" Style="{StaticResource BadgeStyle}" Margin="10,0,0,0"
                              Background="{Binding Level, Converter={StaticResource WarningLevelToBackground}}">
                        <TextBlock Text="{Binding Level, Converter={StaticResource WarningLevelToText}}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding Level, Converter={StaticResource WarningLevelToBrush}}" />
                      </Border>

                      <TextBlock Grid.Column="2" Text="{Binding Text}" Margin="12,0,0,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />

                      <TextBlock Grid.Column="3" Text="{Binding DueDate, StringFormat=dd.MM.yyyy}"
                                 Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center"
                                 Margin="12,0,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
