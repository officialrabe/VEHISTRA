<UserControl x:Class="Vehistra.Client.Views.Dialogs.AccidentEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="920">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <Grid>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Style="{StaticResource PageSubtitleStyle}"
                     Text="Kein Schuldanerkenntnis abgeben. Angaben wahrheitsgemäß und vollständig erfassen." />
        </StackPanel>
        <Button Content="Unfallbericht _drucken" HorizontalAlignment="Right" VerticalAlignment="Center"
                MinWidth="180" Command="{Binding PrintReportCommand}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="580" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <GroupBox Header="Fahrzeug und Fahrer">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Fahrzeug *" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"
                        DisplayMemberPath="DisplayName" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Fahrer" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"
                        DisplayMemberPath="DisplayName" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Telefon Fahrer" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding DriverPhone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="Kilometerstand" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Zeitpunkt und Ort">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Datum" Style="{StaticResource FieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding OccurredAt}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Ort / Straße" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Straße" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="PLZ" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="8">
              <TextBlock Text="Ort" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Art des Schadens und Hergang">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Unfallart" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Sonstiges (Beschreibung)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding TypeOther, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Unfallhergang" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
            <TextBox Text="{Binding CourseOfEvents, UpdateSourceTrigger=PropertyChanged}" MinHeight="90"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <CheckBox Content="Fremdbeteiligung" IsChecked="{Binding ThirdPartyInvolved}" Margin="0,0,20,0" />
              <CheckBox Content="Personenschaden" IsChecked="{Binding PersonalInjury}" Margin="0,0,20,0" />
              <CheckBox Content="Polizei aufgenommen" IsChecked="{Binding PoliceInvolved}" Margin="0,0,20,0" />
              <CheckBox Content="Fahrzeug fahrbereit" IsChecked="{Binding VehicleDriveable}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Dienststelle" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding PoliceStation, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Tagebuchnummer" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding PoliceFileNumber, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Eigene Schadennummer" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding OwnInsuranceClaimNumber, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Beteiligter Dritter (wird beim Speichern ergänzt)">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Kennzeichen" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantLicensePlate, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Nachname" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantLastName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Vorname" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantFirstName, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="6">
                <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantPhone, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Straße" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantStreet, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="PLZ" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantPostalCode, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Ort" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantCity, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="6">
                <TextBlock Text="Versicherung" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantInsurance, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="8">
                <TextBlock Text="Versicherungsnr." Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ParticipantInsuranceNumber, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <DataGrid ItemsSource="{Binding Participants}" MaxHeight="110" Margin="0,12,0,0">
              <DataGrid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TabellenZellenText}" />
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Kennzeichen" Binding="{Binding LicensePlate}" Width="130" />
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="140" />
                <DataGridTextColumn Header="Versicherung" Binding="{Binding InsuranceCompany}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Zeuge und Folgeschaden">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Zeuge (Name)" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding WitnessName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Telefon Zeuge" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding WitnessPhone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <CheckBox Content="Schaden zum Unfall anlegen" IsChecked="{Binding CreateDamage}" />
              <TextBox Text="{Binding DamageDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                       IsEnabled="{Binding CreateDamage}" />
              <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0"
                         Text="Beschreibung des Fahrzeugschadens (z. B. Heckschaden durch Auffahrunfall)." />
            </StackPanel>
          </Grid>
        </GroupBox>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
