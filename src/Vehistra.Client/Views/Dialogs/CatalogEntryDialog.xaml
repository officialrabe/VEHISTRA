<UserControl x:Class="Vehistra.Client.Views.Dialogs.CatalogEntryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
    </Border>

    <StackPanel Grid.Row="1" Margin="18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Bezeichnung *" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                   IsEnabled="{Binding CanEditName}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Sortierung" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"
                   ToolTip="Kleinere Zahlen stehen in den Auswahllisten oben" />
        </StackPanel>
        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
          <CheckBox Content="Steht zur Auswahl" IsChecked="{Binding IsActive}"
                    IsEnabled="{Binding IsNew, Converter={StaticResource InverseBool}}"
                    ToolTip="Stillgelegte Einträge bleiben an bereits erfassten Daten erhalten" />
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding NameHint}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                 TextWrapping="Wrap" Visibility="{Binding NameHint, Converter={StaticResource StringToVisibility}}" />

      <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
               MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" />

      <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowColor, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Farbe" Style="{StaticResource FieldLabelStyle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox IsEditable="True" ItemsSource="{Binding Colors}"
                    Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border Width="16" Height="16" CornerRadius="3"
                          Background="{Binding Converter={StaticResource HexToBrush}}"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border Grid.Column="2" Width="34" Height="26" CornerRadius="3"
                  Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
        </Grid>
        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Die Farbe ergänzt die Bezeichnung in den Listen. Leer lassen heißt: keine eigene Farbe. Die Bezeichnung steht immer daneben, die Farbe ist nie die einzige Information." />
      </StackPanel>

      <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowSemantic, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Fachliche Bedeutung" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding Semantics}" SelectedValue="{Binding Semantic}"
                  SelectedValuePath="Value" DisplayMemberPath="Key" />
        <TextBlock Text="{Binding SemanticHint}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox Content="Zählt als einsatzbereit" IsChecked="{Binding CountsAsOperational}"
                    ToolTip="Fahrzeuge in diesem Status erscheinen im Überblick unter „einsatzbereit“" />
          <CheckBox Content="Zählt als verfügbar" Margin="20,0,0,0" IsChecked="{Binding CountsAsAvailable}"
                    ToolTip="Fahrzeuge in diesem Status gelten als frei, also nicht im Einsatz" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
