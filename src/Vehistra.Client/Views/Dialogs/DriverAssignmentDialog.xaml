<UserControl x:Class="Vehistra.Client.Views.Dialogs.DriverAssignmentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="220" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                   Text="Die bisherige Zuweisung wird beendet und bleibt als Historie erhalten." />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="18,18,18,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Fahrer" Style="{StaticResource FieldLabelStyle}" />
          <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"
                    DisplayMemberPath="DisplayName" IsEnabled="{Binding RemoveAssignment,
                    Converter={StaticResource InverseBool}}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Gültig ab" Style="{StaticResource FieldLabelStyle}" />
          <DatePicker SelectedDate="{Binding ValidFrom}" />
        </StackPanel>
      </Grid>

      <CheckBox Content="Zuweisung entfernen (Fahrzeug hat künftig keinen festen Fahrer)"
                IsChecked="{Binding RemoveAssignment}" Margin="0,12,0,0" />

      <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
               TextWrapping="Wrap" />

      <TextBlock Text="FAHRERHISTORIE" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
    </StackPanel>

    <DataGrid Grid.Row="2" Margin="18,0,18,0" ItemsSource="{Binding History}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Fahrer" Binding="{Binding Driver.DisplayName}" Width="*" />
        <DataGridTextColumn Header="Von" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="110" />
        <DataGridTextColumn Header="Bis" Binding="{Binding ValidTo, StringFormat=dd.MM.yyyy,
                                                   TargetNullValue='aktuell'}" Width="110" />
        <DataGridTextColumn Header="Zugewiesen durch" Binding="{Binding AssignedByUserName}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8" Margin="0,10,0,0"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Zuweisen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
