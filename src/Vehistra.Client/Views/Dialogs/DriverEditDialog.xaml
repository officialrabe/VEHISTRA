<UserControl x:Class="Vehistra.Client.Views.Dialogs.DriverEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="620">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
    </Border>

    <StackPanel Grid.Row="1" Margin="18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Personalnummer" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding PersonnelNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
          <CheckBox Content="Fahrer ist aktiv" IsChecked="{Binding IsActive}" />
        </StackPanel>
      </Grid>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Vorname" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Nachname *" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
        </StackPanel>
      </Grid>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Mobil" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="E-Mail" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
