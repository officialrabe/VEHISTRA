<UserControl x:Class="Vehistra.Client.Views.Dialogs.InspectionEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <TextBlock Text="{Binding VehicleDisplay}" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Art der Prüfung" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Prüfdatum *" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding InspectionDate}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Nächste Fälligkeit *" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding NextDueDate}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Ergebnis" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding Result}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Nächste AU" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding NextEmissionDueDate}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Kilometerstand" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Prüfstelle" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding TestCenter, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Prüfer" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Inspector, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Kosten (EUR)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Festgestellte Mängel" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Defects, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" AcceptsReturn="True"
                 TextWrapping="Wrap" />

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
