<UserControl x:Class="Vehistra.Client.Views.Dialogs.MaintenanceEntryEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                   Text="Nach dem Speichern wird die nächste Fälligkeit automatisch aus der Wartungsregel berechnet." />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <TextBlock Text="{Binding VehicleDisplay}" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock Text="Wartungsregel" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Name" />

        <TextBlock Text="Bezeichnung (falls keine Regel gewählt)" Style="{StaticResource FieldLabelStyle}"
                   Margin="0,12,0,2" />
        <TextBox Text="{Binding CustomTitle, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Durchgeführt am *" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding PerformedAt}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Kilometerstand" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Nächste Fälligkeit" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding NextDueDate}" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Text="Nächste Fälligkeit (km)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding NextDueMileage, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Werkstatt" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Workshops}" SelectedItem="{Binding SelectedWorkshop}"
                      DisplayMemberPath="Name" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Ausgeführt von" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding PerformedBy, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Kosten (EUR)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
