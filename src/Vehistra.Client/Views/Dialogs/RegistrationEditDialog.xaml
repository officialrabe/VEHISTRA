<UserControl x:Class="Vehistra.Client.Views.Dialogs.RegistrationEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="620">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <TextBlock Text="{Binding VehicleDisplay}" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Datum *" Style="{StaticResource FieldLabelStyle}" />
            <DatePicker SelectedDate="{Binding Date}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Zulassungsstelle" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RegistrationOffice, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsRegistration}" />
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRegistration,
                                                  Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Kennzeichen zuweisen" Style="{StaticResource FieldLabelStyle}" />
          <ComboBox ItemsSource="{Binding AvailablePlates}" SelectedItem="{Binding SelectedPlate}"
                    DisplayMemberPath="Plate" />
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                     Text="Ein bisher zugeordnetes Kennzeichen wird automatisch historisiert und freigegeben." />
        </StackPanel>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRegistration,
                                                  Converter={StaticResource BoolToVisibility},
                                                  ConverterParameter=invert}">
          <TextBlock Text="Grund der Abmeldung" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox Content="Kennzeichen freigeben" IsChecked="{Binding ReleaseLicensePlate}" Margin="0,10,0,0" />
        </StackPanel>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Übernehmen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
