<UserControl x:Class="Vehistra.Client.Views.Dialogs.StatusChangeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="220" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding VehicleDisplay}" Style="{StaticResource PageSubtitleStyle}" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="18,18,18,10">
      <TextBlock Text="Neuer Status *" Style="{StaticResource FieldLabelStyle}" />
      <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" />

      <TextBlock Text="Grund" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" />

      <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
      <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
               TextWrapping="Wrap" />

      <TextBlock Text="STATUSHISTORIE" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
    </StackPanel>

    <DataGrid Grid.Row="2" Margin="18,0,18,0" ItemsSource="{Binding History}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding ChangedAt, StringFormat=dd.MM.yyyy HH:mm}"
                            Width="150" />
        <DataGridTextColumn Header="Von" Binding="{Binding OldStatus.Name}" Width="130" />
        <DataGridTextColumn Header="Nach" Binding="{Binding NewStatus.Name}" Width="130" />
        <DataGridTextColumn Header="Benutzer" Binding="{Binding ChangedByUserName}" Width="150" />
        <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8" Margin="0,10,0,0"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Status ändern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
