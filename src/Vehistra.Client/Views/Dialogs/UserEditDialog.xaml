<UserControl x:Class="Vehistra.Client.Views.Dialogs.UserEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Benutzername *" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Vorname" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Nachname *" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="E-Mail" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Personalnummer" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding PersonnelNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Startpasswort *" Style="{StaticResource FieldLabelStyle}" />
          <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" />
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                     Text="Das Passwort wird ausschließlich als PBKDF2-Hash gespeichert. Der Benutzer sollte es nach der ersten Anmeldung ändern." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <CheckBox Content="Konto ist aktiv" IsChecked="{Binding IsActive}" Margin="0,0,20,0" />
          <CheckBox Content="Passwortänderung beim nächsten Login erforderlich"
                    IsChecked="{Binding MustChangePassword}" />
        </StackPanel>

        <GroupBox Header="Rollen *" Margin="0,14,0,0">
          <ItemsControl ItemsSource="{Binding Roles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,3">
                  <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" FontSize="11"
                             Margin="22,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </GroupBox>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
