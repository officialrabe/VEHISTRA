<UserControl x:Class="Vehistra.Client.Views.Dialogs.VehicleKeyEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Schlüsselnummer *" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding KeyNumber, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Anzahl" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Aufbewahrungsort" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <GroupBox Header="Ausgabe und Rückgabe" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Ausgegeben an (Fahrer)" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding IssuedToDriver}"
                        DisplayMemberPath="DisplayName" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="oder Name" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding IssuedToName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Ausgegeben am" Style="{StaticResource FieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding IssuedAt}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="Zurückgegeben am" Style="{StaticResource FieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding ReturnedAt}" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,2" />
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" AcceptsReturn="True"
                 TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
