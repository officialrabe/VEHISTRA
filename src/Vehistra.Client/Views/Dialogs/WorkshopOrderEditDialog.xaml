<UserControl x:Class="Vehistra.Client.Views.Dialogs.WorkshopOrderEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}" Padding="18,12">
      <Grid>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Rückmeldung _übernehmen" MinWidth="190" Command="{Binding RecordFeedbackCommand}" />
          <Button Content="Werkstattbericht _drucken" Margin="8,0,0,0" MinWidth="190"
                  Command="{Binding PrintReportCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="18">
      <StackPanel>
        <GroupBox Header="Auftrag">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Fahrzeug *" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"
                          DisplayMemberPath="DisplayName" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Fahrer" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"
                          DisplayMemberPath="DisplayName" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Werkstatt" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Workshops}" SelectedItem="{Binding SelectedWorkshop}"
                          DisplayMemberPath="Name" />
              </StackPanel>
              <StackPanel Grid.Column="6">
                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding StatusValues}" SelectedItem="{Binding Status}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Auftrag erstellt am" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding CreatedOn}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Terminvorschlag" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding ProposedDate}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Vereinbarter Termin" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding AppointmentDate}" />
              </StackPanel>
              <StackPanel Grid.Column="6">
                <TextBlock Text="Fahrzeug abgegeben" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding VehicleHandedOverAt}" />
              </StackPanel>
              <StackPanel Grid.Column="8">
                <TextBlock Text="Fertigstellung geplant" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding PlannedCompletionAt}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Grund" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Auszuführende Arbeiten (eine Zeile je Arbeit)" Style="{StaticResource FieldLabelStyle}"
                       Margin="0,12,0,2" />
            <TextBox Text="{Binding WorkToPerform, UpdateSourceTrigger=PropertyChanged}" MinHeight="70"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Offene Schäden des Fahrzeugs">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                       Text="Ausgewählte Schäden werden beim Anlegen als Arbeitspositionen übernommen und mit dem Vorgang verknüpft." />
            <ItemsControl ItemsSource="{Binding OpenDamages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                      <Border Style="{StaticResource BadgeStyle}" Margin="8,0,0,0"
                              Background="{StaticResource SurfaceSunkenBrush}">
                        <TextBlock Text="{Binding PriorityText}" FontSize="10" />
                      </Border>
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Arbeitspositionen">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Beschreibung der Arbeit" />
              <Button Grid.Column="1" Content="_Hinzufügen" Margin="8,0,0,0" MinWidth="120"
                      Command="{Binding AddTaskCommand}" />
            </Grid>

            <DataGrid x:Name="TaskGrid" ItemsSource="{Binding Tasks}" MaxHeight="180" Margin="0,10,0,0">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Als erledigt markieren / zurücksetzen"
                            Command="{Binding PlacementTarget.DataContext.ToggleTaskCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding SelectedItem, ElementName=TaskGrid}" />
                  <MenuItem Header="Entfernen"
                            Command="{Binding PlacementTarget.DataContext.RemoveTaskCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandParameter="{Binding SelectedItem, ElementName=TaskGrid}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nr." Binding="{Binding Position}" Width="50" />
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*" />
                <DataGridCheckBoxColumn Header="Erledigt" Binding="{Binding IsCompleted}" Width="80" />
                <DataGridTextColumn Header="Erledigt am" Binding="{Binding CompletedAt, StringFormat=dd.MM.yyyy}"
                                    Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Rückmeldung der Werkstatt">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Kosten netto" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding CostNet, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Kosten brutto" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding CostGross, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Fertig am" Style="{StaticResource FieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding CompletedAt}" />
            </StackPanel>
            <StackPanel Grid.Column="6">
              <TextBlock Text="Abgeholt am" Style="{StaticResource FieldLabelStyle}" />
              <DatePicker SelectedDate="{Binding PickedUpAt}" />
            </StackPanel>
            <StackPanel Grid.Column="8">
              <TextBlock Text="Rechnungsnummer" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="10">
              <TextBlock Text="Nächster Service bei km" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding NextServiceMileage, UpdateSourceTrigger=PropertyChanged,
                                      TargetNullValue=''}" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Kilometerstand bei Abgabe" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding MileageAtHandover, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Bemerkung" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="54"
                     AcceptsReturn="True" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" IsDefault="True"
                Command="{Binding ConfirmCommand}" />
        <Button Content="Abbre_chen" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
