<UserControl x:Class="Vehistra.Client.Views.DriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="_Neuer Fahrer" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"
                  Command="{Binding CreateCommand}"
                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Fahrer_akte öffnen" Margin="8,0,0,0" Command="{Binding OpenFileCommand}"
                  MinWidth="150"
                  ToolTip="Stammdaten, Fahrzeuge, Schäden, Unfälle und Werkstattvorgänge dieses Fahrers" />
          <Button Content="_Bearbeiten" Margin="8,0,0,0" Command="{Binding EditCommand}"
                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Aktiv / _Inaktiv" Margin="8,0,0,0" Command="{Binding ToggleActiveCommand}"
                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
          <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
          <Button Content="_Importieren" Command="{Binding ImportCommand}"
                  Visibility="{Binding CanImport, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Export CSV" Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="csv"
                  Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Export XLSX" Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="xlsx"
                  Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <CheckBox Content="inaktive anzeigen" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center"
                    Margin="0,0,12,0" />
          <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                   ToolTip="Suche nach Name oder Personalnummer" />
          <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <DataGrid ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}">
        <DataGrid.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenFileCommand}" />
        </DataGrid.InputBindings>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Personalnummer" Binding="{Binding PersonnelNumber}" Width="140" />
          <DataGridTextColumn Header="Nachname" Binding="{Binding LastName}" Width="*" FontWeight="SemiBold" />
          <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName}" Width="*" />
          <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="140" />
          <DataGridTextColumn Header="Mobil" Binding="{Binding Mobile}" Width="140" />
          <DataGridTemplateColumn Header="Status" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border>
                  <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToYesNo}}" FontSize="11" />
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
                      <Setter Property="Background" Value="{StaticResource OkBackgroundBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                          <Setter Property="Background" Value="{StaticResource InactiveBackgroundBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Bemerkung" Binding="{Binding Comment}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource ToolbarStyle}">
            <TextBlock Text="FAHRZEUGE DES AUSGEWÄHLTEN FAHRERS" FontWeight="SemiBold" FontSize="11" />
          </Border>

          <DataGrid x:Name="AssignmentGrid" Grid.Row="1" ItemsSource="{Binding Assignments}" BorderThickness="0">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenVehicleCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=AssignmentGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fahrzeug" Binding="{Binding Vehicle.DisplayName}" Width="*" />
              <DataGridTextColumn Header="Von" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="100" />
              <DataGridTextColumn Header="Bis" Binding="{Binding ValidTo, StringFormat=dd.MM.yyyy,
                                                         TargetNullValue='aktuell'}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
