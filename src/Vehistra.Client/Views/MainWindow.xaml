<Window x:Class="Vehistra.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vehistra.Client.ViewModels"
        xmlns:conv="clr-namespace:Vehistra.Client.Converters"
        Title="Vehistra" Height="1000" Width="1720"
        MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource SurfaceAltBrush}">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

    <!-- Eintrag der Seitenleiste -->
    <DataTemplate x:Key="NavigationItemTemplate" DataType="{x:Type vm:NavigationItem}">
      <Grid>
        <!-- Abschnittsueberschrift -->
        <TextBlock Text="{Binding Title}" Margin="18,16,10,6" FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource SidebarSectionBrush}"
                   Visibility="{Binding IsSection, Converter={StaticResource BoolToVisibility}}" />

        <!-- Navigationsschaltflaeche -->
        <Button Visibility="{Binding IsSection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                HorizontalContentAlignment="Stretch" MinWidth="0" Padding="0" BorderThickness="0"
                Background="Transparent" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="Transparent" Padding="14,0" Height="38"
                      BorderThickness="3,0,0,0" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="22"
                             Foreground="{StaticResource SidebarTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="13"
                             Foreground="{StaticResource SidebarTextBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SidebarActiveBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Seitenleiste -->
    <Border Background="{StaticResource SidebarBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="18,20,18,14">
          <TextBlock Text="VEHISTRA" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource TextInvertedBrush}" />
          <TextBlock Text="Open Fleet Management" FontSize="10" FontWeight="Light" Margin="0,1,0,0"
                     Foreground="{StaticResource SidebarTextBrush}" />
          <TextBlock Text="{Binding CompanyName}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource SidebarSectionBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NavigationItems}"
                        ItemTemplate="{StaticResource NavigationItemTemplate}" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="18,12,18,16">
          <Border Height="1" Background="{StaticResource SidebarHoverBrush}" Margin="0,0,0,12" />
          <TextBlock Text="Developed &amp; maintained by" FontSize="10"
                     Foreground="{StaticResource SidebarSectionBrush}" />
          <TextBlock Text="LSP Virtual Services" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource SidebarTextBrush}" />
          <TextBlock Text="vehistra.dev" FontSize="10" Margin="0,2,0,0"
                     Foreground="{StaticResource SidebarSectionBrush}" />
          <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource SidebarSectionBrush}">
            <Run Text="Vehistra" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Arbeitsbereich -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Kopfzeile -->
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1" Padding="20,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentView.Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding CurrentView.Subtitle}" Style="{StaticResource PageSubtitleStyle}"
                       Visibility="{Binding CurrentView.Subtitle, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>

          <!-- Globale Suche -->
          <Grid Grid.Column="1" Width="330" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Suche nach Kennzeichen, Fahrzeugnummer, FIN, Fahrer, Schadens- oder Unfallnummer (Strg+F)" />
            <TextBlock IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Suchen: Kennzeichen, FIN, Fahrer, Nummer ...">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <Popup IsOpen="{Binding IsSearchOpen}" PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Bottom" Width="430" StaysOpen="False" AllowsTransparency="True">
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1" Padding="4">
                <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="420">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                              Padding="8,6" MinWidth="0"
                              Command="{Binding DataContext.OpenSearchResultCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource BadgeStyle}"
                                    Background="{StaticResource SurfaceSunkenBrush}">
                              <TextBlock Text="{Binding EntityType}" FontSize="10" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}"
                                     Margin="0,2,0,0" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Popup>
          </Grid>

          <!-- Benachrichtigungen und Benutzer -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="NotificationButton" MinWidth="0" Padding="9,5" Click="OnToggleNotifications"
                    ToolTip="Benachrichtigungen">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                <Border Margin="6,0,0,0" CornerRadius="8" Padding="6,1"
                        Background="{StaticResource CriticalBrush}"
                        Visibility="{Binding UnreadNotifications, Converter={StaticResource NotificationCountConverter}}">
                  <TextBlock Text="{Binding UnreadNotifications}" FontSize="10" FontWeight="Bold"
                             Foreground="White" />
                </Border>
              </StackPanel>
            </Button>

            <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=NotificationButton}"
                   Placement="Bottom" Width="440" StaysOpen="False" AllowsTransparency="True">
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Border Style="{StaticResource ToolbarStyle}">
                    <Grid>
                      <TextBlock Text="Benachrichtigungen" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Content="Alle als gelesen markieren" HorizontalAlignment="Right"
                              Style="{StaticResource LinkButtonStyle}"
                              Command="{Binding MarkAllNotificationsReadCommand}" />
                    </Grid>
                  </Border>

                  <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Notifications}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button HorizontalContentAlignment="Stretch" BorderThickness="0,0,0,1" MinWidth="0"
                                  BorderBrush="{StaticResource BorderBrush}" Background="Transparent" Padding="12,8"
                                  Command="{Binding DataContext.MarkNotificationReadCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource BadgeStyle}"
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBackgroundConverter}}">
                                  <TextBlock Text="{Binding Category, Converter={StaticResource EnumToText}}"
                                             FontSize="10"
                                             Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" />
                                </Border>
                                <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                           Style="{StaticResource PageSubtitleStyle}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4,0,0" />
                              <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                         Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Popup>

            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="{Binding UserDisplay}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding RoleDisplay}" Style="{StaticResource PageSubtitleStyle}"
                         HorizontalAlignment="Right" />
            </StackPanel>

            <Button Content="_Abmelden" Command="{Binding LogoutCommand}" MinWidth="100" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Hinweisleiste fuer verfuegbare Updates -->
      <Border Grid.Row="1" Background="{StaticResource InfoBackgroundBrush}"
              BorderBrush="{StaticResource InfoBrush}" BorderThickness="0,0,0,1" Padding="20,8"
              Visibility="{Binding UpdateBanner, Converter={StaticResource StringToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding UpdateBanner}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Inhalt -->
      <ContentControl Grid.Row="2" Content="{Binding CurrentView}" Margin="0" />

      <!-- Statusleiste -->
      <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0" Padding="20,5">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentView.StatusMessage}" Style="{StaticResource PageSubtitleStyle}"
                       VerticalAlignment="Center" />
            <ProgressBar Width="140" Margin="12,0,0,0" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding CurrentView.IsBusy, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <TextBlock HorizontalAlignment="Right" Style="{StaticResource PageSubtitleStyle}"
                     VerticalAlignment="Center">
            <Run Text="{Binding CompanyName, Mode=OneWay}" /><Run Text=" · Vehistra " /><Run
              Text="{Binding Version, Mode=OneWay}" /><Run Text=" · Developed &amp; maintained by LSP Virtual Services" />
          </TextBlock>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
