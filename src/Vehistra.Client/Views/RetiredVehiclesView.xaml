<UserControl x:Class="Vehistra.Client.Views.RetiredVehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="_Fahrzeugakte öffnen" Command="{Binding OpenVehicleCommand}" MinWidth="160" />
          <Button Content="Ausmusterung _zurücknehmen" Margin="8,0,0,0" MinWidth="200"
                  Command="{Binding UndoRetirementCommand}"
                  Visibility="{Binding CanRetire, Converter={StaticResource BoolToVisibility}}" />
          <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
          <Button Content="Export CSV" Command="{Binding ExportCommand}" CommandParameter="csv"
                  Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Export XLSX" Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="xlsx"
                  Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <ComboBox Width="220" ItemsSource="{Binding ReasonValues}" SelectedItem="{Binding ReasonFilter}"
                    ToolTip="Nach Ausmusterungsgrund filtern">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource InfoBackgroundBrush}" Padding="18,8">
      <TextBlock TextWrapping="Wrap"
                 Text="Ausgemusterte Fahrzeuge werden nicht gelöscht. Alle Schäden, Unfälle, Werkstattvorgänge, Kennzeichen- und Fahrerhistorien bleiben dauerhaft nachvollziehbar." />
    </Border>

    <DataGrid Grid.Row="2" Margin="12" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenVehicleCommand}" />
      </DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Interne Nr." Binding="{Binding InternalNumber}" Width="110" />
        <DataGridTextColumn Header="Kennzeichen" Binding="{Binding LicensePlate}" Width="130" />
        <DataGridTextColumn Header="Hersteller" Binding="{Binding Manufacturer}" Width="140" />
        <DataGridTextColumn Header="Modell" Binding="{Binding Model}" Width="160" />
        <DataGridTextColumn Header="Ausgemustert am" Binding="{Binding Retirement.RetiredAt, StringFormat=dd.MM.yyyy}"
                            Width="150" FontWeight="SemiBold" />
        <DataGridTextColumn Header="Grund"
                            Binding="{Binding Retirement.Reason, Converter={StaticResource EnumToText}}" Width="200" />
        <DataGridTextColumn Header="Letzter km-Stand" Binding="{Binding Retirement.LastMileage, StringFormat=N0}"
                            Width="140" />
        <DataGridTextColumn Header="Abgemeldet"
                            Binding="{Binding Retirement.IsDeregistered, Converter={StaticResource BoolToYesNo}}"
                            Width="110" />
        <DataGridTextColumn Header="Verschrottet"
                            Binding="{Binding Retirement.IsScrapped, Converter={StaticResource BoolToYesNo}}"
                            Width="120" />
        <DataGridTextColumn Header="Verkauft"
                            Binding="{Binding Retirement.IsSold, Converter={StaticResource BoolToYesNo}}"
                            Width="100" />
        <DataGridTextColumn Header="Bemerkung" Binding="{Binding Retirement.Comment}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
