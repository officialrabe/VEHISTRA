<Window x:Class="Vehistra.Client.Views.ServerUnavailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server nicht erreichbar – Vehistra" Height="520" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource CriticalBackgroundBrush}" Padding="22,18">
      <StackPanel>
        <TextBlock x:Name="HeadlineText" Text="SERVER NICHT ERREICHBAR" FontSize="19" FontWeight="SemiBold"
                   Foreground="{StaticResource CriticalBrush}" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Die Verbindung zur Fuhrparkdatenbank konnte nicht hergestellt werden." />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="22,18,22,0">
      <StackPanel>
        <TextBlock x:Name="ServerLabel" Text="Server" Style="{StaticResource FieldLabelStyle}" />
        <TextBlock x:Name="ServerText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />

        <TextBlock x:Name="DatabaseLabel" Text="Datenbank" Style="{StaticResource FieldLabelStyle}"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="DatabaseText" FontWeight="SemiBold" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="22,14,22,0"
            Background="{StaticResource SurfaceSunkenBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="DiagnosticsText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                 Text="Bitte prüfen Sie:&#x0a;&#x0a;1. Ist der Server eingeschaltet und im Netz erreichbar?&#x0a;2. Läuft der Dienst „SQL Server (SQLEXPRESS)“?&#x0a;3. Ist im SQL Server Configuration Manager TCP/IP aktiviert?&#x0a;4. Ist die Windows-Firewall für den SQL Server freigegeben?&#x0a;5. Ist der Servername in den Einstellungen korrekt?&#x0a;&#x0a;Mit „Diagnose“ führen Sie eine automatische Prüfung durch." />
      </ScrollViewer>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="22,14" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="_Erneut versuchen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150"
                IsDefault="True" Click="OnRetry" />
        <Button Content="_Diagnose" Margin="8,0,0,0" MinWidth="120" Click="OnDiagnose" />
        <Button Content="_Servereinstellungen" Margin="8,0,0,0" MinWidth="160" Click="OnServerSettings" />
        <Button Content="Programm _beenden" Margin="8,0,0,0" MinWidth="150" Click="OnExit" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
