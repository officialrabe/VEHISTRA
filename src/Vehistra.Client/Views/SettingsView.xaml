<UserControl x:Class="Vehistra.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="_Speichern" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"
                Command="{Binding SaveCommand}" />
        <Button Content="_Verwerfen" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource OkBrush}" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="UNTERNEHMEN">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"
                       Text="Diese Angaben erscheinen in der Oberfläche und auf allen PDF-Berichten. Der Unternehmensname ist nicht fest im Programm hinterlegt, sondern wird hier gepflegt." />

            <TextBlock Text="Unternehmensname" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Straße" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding CompanyStreet, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="PLZ" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding CompanyPostalCode, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Ort" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding CompanyCity, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="E-Mail" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Firmenlogo (für PDF-Berichte)" Style="{StaticResource FieldLabelStyle}"
                       Margin="0,12,0,2" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding CompanyLogoPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Width="40" MinWidth="40" Margin="6,0,0,0"
                      Command="{Binding BrowseLogoCommand}" />
            </Grid>

            <TextBlock Text="Hinweistext im Werkstattbericht" Style="{StaticResource FieldLabelStyle}"
                       Margin="0,16,0,2" />
            <TextBox Text="{Binding WorkshopReportNotice, UpdateSourceTrigger=PropertyChanged}" MinHeight="54"
                     AcceptsReturn="True" TextWrapping="Wrap" />

            <TextBlock Text="Hinweistext im Unfallbericht" Style="{StaticResource FieldLabelStyle}"
                       Margin="0,12,0,2" />
            <TextBox Text="{Binding AccidentReportNotice, UpdateSourceTrigger=PropertyChanged}" MinHeight="54"
                     AcceptsReturn="True" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="FRISTEN &amp; WARNUNGEN">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
          <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <GroupBox Header="TÜV / Hauptuntersuchung">
              <StackPanel>
                <TextBlock Text="Warnstufe „kritisch“ ab (Tage vor Ablauf)"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding InspectionUrgentDays, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left"
                         ToolTip="Ab hier gilt die Frist als kritisch, auch wenn der Termin noch nicht erreicht ist" />
                <TextBlock Text="Warnstufe „bald fällig“ ab (Tage vor Ablauf)"
                           Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                <TextBox Text="{Binding InspectionCriticalDays, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Text="Warnstufe „Hinweis“ ab (Tage vor Ablauf)" Style="{StaticResource FieldLabelStyle}"
                           Margin="0,12,0,2" />
                <TextBox Text="{Binding InspectionWarningDays, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Die drei Stufen liegen ineinander: kritisch vor „bald fällig“ vor Hinweis. Abgelaufene Fristen sind immer kritisch. Jede Stufe steht zusätzlich als Text in der Liste – Farbe ist nie die einzige Information." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Wartung">
              <StackPanel>
                <TextBlock Text="Vorwarnzeit in Tagen" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding MaintenanceWarnDays, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Text="Vorwarnung in Kilometern" Style="{StaticResource FieldLabelStyle}"
                           Margin="0,12,0,2" />
                <TextBox Text="{Binding MaintenanceWarnKilometers, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Sicherungen">
              <StackPanel>
                <TextBlock Text="Aufbewahrungsdauer in Tagen (0 = nichts löschen)"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding BackupRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Mit einer Dauer größer 0 entfernt das Programm nach jeder Sicherung die älteren. Es löscht nur Dateien aus dem Sicherungsverzeichnis, die es selbst angelegt hat; die drei neuesten Sicherungen und alle Sicherungen vor einer Migration bleiben immer erhalten. Jede Löschung steht im Protokoll. Unter „Backups“ können Sie vorher ansehen, was wegfallen würde." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Werkstatt">
              <StackPanel>
                <TextBlock Text="Warnung, wenn ein Fahrzeug länger als (Tage) in der Werkstatt steht"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding WorkshopLongStayWarnDays, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Gezählt wird ab der Fahrzeugabgabe. Ab der doppelten Frist gilt der Vorgang als kritisch. Der Überblick zeigt die Zahl, ein Klick darauf die betroffenen Vorgänge." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Dokumente">
              <StackPanel>
                <TextBlock Text="Maximale Dateigröße (MB)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding DocumentMaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Zulässig sind 1 bis 50 MB. Unabhängig davon prüft die Ablage den Dateiinhalt: Was wie ein Programm aussieht, wird abgelehnt, auch wenn die Endung etwas anderes sagt." />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Kennzeichenreservierung">
              <StackPanel>
                <TextBlock Text="Warnungen X Tage vorher (mit Semikolon getrennt)"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding PlateReservationWarnDays, UpdateSourceTrigger=PropertyChanged}" Width="260"
                         HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                           Text="Beispiel: 30;14;7;3;1" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Updates">
              <CheckBox Content="Beim Programmstart nach Updates suchen" IsChecked="{Binding CheckUpdatesOnStart}" />
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="PFADE">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Dokumentenablage (UNC-Pfad)" Style="{StaticResource FieldLabelStyle}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding DocumentsPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Width="40" MinWidth="40" Margin="6,0,0,0"
                      Command="{Binding BrowseDocumentsCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                       Text="Beispiel: \\FUHRPARK-SRV01\Fuhrpark\Dokumente" />

            <TextBlock Text="Backupverzeichnis (Pfad auf dem Datenbankserver)"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,2" />
            <TextBox Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                       Text="Beispiel: D:\Fuhrpark\Backups – dieses Verzeichnis nutzt der SQL Server." />

            <TextBlock Text="Updateablage (UNC-Pfad)" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,2" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding UpdatePath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="..." Width="40" MinWidth="40" Margin="6,0,0,0"
                      Command="{Binding BrowseUpdatesCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                       Text="Beispiel: \\FUHRPARK-SRV01\Fuhrpark\Updates" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="SICHERHEIT &amp; DARSTELLUNG">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
          <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <GroupBox Header="Anmeldung">
              <StackPanel>
                <TextBlock Text="Maximale Fehlversuche vor Kontosperre" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding MaxFailedLogins, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Text="Sperrdauer in Minuten" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                <TextBox Text="{Binding LockoutMinutes, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
                <TextBlock Text="Mindestlänge des Passworts" Style="{StaticResource FieldLabelStyle}"
                           Margin="0,12,0,2" />
                <TextBox Text="{Binding PasswordMinimumLength, UpdateSourceTrigger=PropertyChanged}" Width="120"
                         HorizontalAlignment="Left" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Darstellung">
              <StackPanel>
                <TextBlock Text="Datumsformat" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" Width="200"
                         HorizontalAlignment="Left" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="STAMMDATEN">
        <Grid Margin="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Style="{StaticResource ToolbarStyle}">
                <StackPanel>
                  <TextBlock Text="FAHRZEUGKATEGORIEN (EINSATZBEREICHE)" FontWeight="SemiBold" FontSize="11" />
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="_Neu" MinWidth="70" Command="{Binding CreateCategoryCommand}"
                            ToolTip="Einen eigenen Einsatzbereich anlegen" />
                    <Button Content="_Bearbeiten" Margin="6,0,0,0" MinWidth="110"
                            Command="{Binding EditCategoryCommand}"
                            ToolTip="Bezeichnung, Beschreibung, Farbe und Reihenfolge ändern" />
                    <Button Content="_Stilllegen / Aktivieren" Margin="6,0,0,0" MinWidth="150"
                            Command="{Binding ToggleCategoryCommand}"
                            ToolTip="Stillgelegte Bereiche erscheinen nicht mehr zur Auswahl, bleiben aber an zugeordneten Fahrzeugen erhalten" />
                    <Button Content="_Löschen" Margin="6,0,0,0" MinWidth="90"
                            Command="{Binding DeleteCategoryCommand}"
                            ToolTip="Nur selbst angelegte Bereiche, die nirgends verwendet werden" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                  <DataGridTextColumn Header="Sortierung" Binding="{Binding SortOrder}" Width="100" IsReadOnly="True" />
                  <DataGridTextColumn Header="Aktiv" Binding="{Binding IsActive, Converter={StaticResource BoolToYesNo}}"
                                      Width="80" IsReadOnly="True" />
                  <DataGridTextColumn Header="Mitgeliefert"
                                      Binding="{Binding IsSystemCategory, Converter={StaticResource BoolToYesNo}}"
                                      Width="110" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Style="{StaticResource ToolbarStyle}">
                <StackPanel>
                  <TextBlock Text="SCHADENSKATEGORIEN" FontWeight="SemiBold" FontSize="11" />
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="N_eu" MinWidth="70" Command="{Binding CreateDamageCategoryCommand}" />
                    <Button Content="B_earbeiten" Margin="6,0,0,0" MinWidth="110"
                            Command="{Binding EditDamageCategoryCommand}"
                            ToolTip="Bezeichnung, Beschreibung und Reihenfolge ändern. Mitgelieferte Kategorien behalten ihren Namen - das Programm findet sie darüber" />
                    <Button Content="St_illlegen / Aktivieren" Margin="6,0,0,0" MinWidth="150"
                            Command="{Binding ToggleDamageCategoryCommand}" />
                    <Button Content="Lö_schen" Margin="6,0,0,0" MinWidth="90"
                            Command="{Binding DeleteDamageCategoryCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding DamageCategories}"
                        SelectedItem="{Binding SelectedDamageCategory}" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                  <DataGridTextColumn Header="Sortierung" Binding="{Binding SortOrder}" Width="100" IsReadOnly="True" />
                  <DataGridTextColumn Header="Aktiv" Binding="{Binding IsActive, Converter={StaticResource BoolToYesNo}}"
                                      Width="80" IsReadOnly="True" />
                  <DataGridTextColumn Header="Mitgeliefert"
                                      Binding="{Binding IsSystemCategory, Converter={StaticResource BoolToYesNo}}"
                                      Width="110" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Style="{StaticResource ToolbarStyle}">
                <StackPanel>
                  <TextBlock Text="FAHRZEUGSTATUS" FontWeight="SemiBold" FontSize="11" />
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="Ne_u" MinWidth="70" Command="{Binding CreateStatusCommand}" />
                    <Button Content="Bear_beiten" Margin="6,0,0,0" MinWidth="110"
                            Command="{Binding EditStatusCommand}"
                            ToolTip="Bezeichnung, Farbe, Reihenfolge und fachliche Bedeutung ändern. Auch bei mitgelieferten Status: die Abläufe hängen an der Bedeutung, nicht am Namen" />
                    <Button Content="Stillle_gen / Aktivieren" Margin="6,0,0,0" MinWidth="150"
                            Command="{Binding ToggleStatusCommand}" />
                    <Button Content="Einsatz_bereit" Margin="6,0,0,0" MinWidth="120"
                            Command="{Binding ToggleStatusOperationalCommand}"
                            ToolTip="Zählen Fahrzeuge in diesem Status im Dashboard als einsatzbereit?" />
                    <Button Content="Ver_fügbar" Margin="6,0,0,0" MinWidth="110"
                            Command="{Binding ToggleStatusAvailableCommand}"
                            ToolTip="Zählen Fahrzeuge in diesem Status als verfügbar (nicht im Einsatz)?" />
                    <Button Content="Lös_chen" Margin="6,0,0,0" MinWidth="90"
                            Command="{Binding DeleteStatusCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Statuses}"
                        SelectedItem="{Binding SelectedStatus}" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                  <DataGridTextColumn Header="Systemstatus"
                                      Binding="{Binding IsSystemStatus, Converter={StaticResource BoolToYesNo}}"
                                      Width="120" IsReadOnly="True" />
                  <DataGridTextColumn Header="Sortierung" Binding="{Binding SortOrder}" Width="100" IsReadOnly="True" />
                  <DataGridTextColumn Header="Aktiv" Binding="{Binding IsActive, Converter={StaticResource BoolToYesNo}}"
                                      Width="80" IsReadOnly="True" />
                  <DataGridTextColumn Header="Einsatzbereit"
                                      Binding="{Binding CountsAsOperational, Converter={StaticResource BoolToYesNo}}"
                                      Width="120" IsReadOnly="True" />
                  <DataGridTextColumn Header="Verfügbar"
                                      Binding="{Binding CountsAsAvailable, Converter={StaticResource BoolToYesNo}}"
                                      Width="100" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Style="{StaticResource ToolbarStyle}">
                <Grid>
                  <TextBlock Text="WERKSTÄTTEN" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Neu" MinWidth="60" Command="{Binding CreateWorkshopCommand}" />
                    <Button Content="Aktiv / Inaktiv" Margin="6,0,0,0" MinWidth="110"
                            Command="{Binding ToggleWorkshopCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Workshops}" SelectedItem="{Binding SelectedWorkshop}"
                        BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Ort" Binding="{Binding City}" Width="140" />
                  <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="140" />
                  <DataGridTextColumn Header="Aktiv" Binding="{Binding IsActive, Converter={StaticResource BoolToYesNo}}"
                                      Width="80" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
