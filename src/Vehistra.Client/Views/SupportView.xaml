<UserControl x:Class="Vehistra.Client.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="_Diagnose durchführen" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180"
                Command="{Binding RunDiagnosticsCommand}" />
        <Button Content="Diagnose _kopieren" Margin="8,0,0,0" Command="{Binding CopyDiagnosticsCommand}"
                MinWidth="160" />
        <Button Content="_Logordner öffnen" Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}"
                MinWidth="150" />
        <Button Content="_Supportpaket erstellen" Margin="8,0,0,0" Command="{Binding CreateSupportPackageCommand}"
                MinWidth="180" />
        <Button Content="Support _kontaktieren" Margin="8,0,0,0" Command="{Binding ContactSupportCommand}"
                MinWidth="170" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="420" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource ToolbarStyle}">
            <TextBlock Text="SYSTEMDIAGNOSE" FontWeight="SemiBold" FontSize="11" />
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding Report.Checks}" Margin="14,14,14,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="3">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource OkBackgroundBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                          <Setter Property="Background" Value="{StaticResource CriticalBackgroundBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" FontSize="13">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="&#xE73E;" />
                          <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                              <Setter Property="Text" Value="&#xEA39;" />
                              <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}"
                                 Visibility="{Binding Hint, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="2" Margin="14" Background="{StaticResource SurfaceSunkenBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                       Background="Transparent" FontFamily="Consolas" FontSize="11" Padding="10" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="VEHISTRA" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
            <TextBlock Text="{Binding ProductTagline}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock Text="{Binding ProductScope}" Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap" Margin="0,2,0,14" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VERSION" />
            <TextBlock Text="{Binding Version}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DEVELOPED BY" />
            <TextBlock Text="{Binding DeveloperName}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DeveloperLine}" Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="WEBSITE" />
            <TextBlock Text="{Binding Website}" Margin="0,0,0,10" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SUPPORT" />
            <TextBlock Text="{Binding SupportAddress}" Margin="0,0,0,10" />

            <TextBlock Text="{Binding Copyright}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,12" />

            <Button Content="Support _kontaktieren" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch" Command="{Binding ContactSupportCommand}" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Es werden ausschließlich Programmversion, Windows-Version und Computername vorbereitet – keine Fahrzeug- oder Personendaten." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="WEITERE FUNKTIONEN" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
            <Button Content="Passwort ändern" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    Command="{Binding ChangePasswordCommand}" />
            <Button Content="Dokumentation öffnen" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                    Command="{Binding OpenDocumentationCommand}" />
            <Button Content="Logordner öffnen" HorizontalAlignment="Stretch"
                    Command="{Binding OpenLogFolderCommand}" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LOGVERZEICHNIS" Margin="0,12,0,2" />
            <TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
