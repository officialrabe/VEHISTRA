<UserControl x:Class="Vehistra.Client.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="Nach Updates _suchen" Command="{Binding CheckCommand}" MinWidth="170" />
        <Button Content="_Update installieren" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                MinWidth="170" Command="{Binding InstallCommand}" IsEnabled="{Binding IsUpdateAvailable}"
                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Bei der Quelle „Internet“ wird das Paket dabei geladen und geprüft" />
        <Button Content="_Datenbank aktualisieren" Margin="8,0,0,0" MinWidth="190"
                Command="{Binding MigrateDatabaseCommand}"
                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="Update_ablage öffnen" Margin="8,0,0,0" Command="{Binding OpenUpdateFolderCommand}"
                MinWidth="170"
                Visibility="{Binding UseOnlineSource, Converter={StaticResource BoolToVisibility},
                                    ConverterParameter=Invert}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
      <StackPanel>
        <UniformGrid Columns="4" Margin="0,0,0,12">
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="INSTALLIERTE VERSION" Style="{StaticResource FieldLabelStyle}" />
              <TextBlock Text="{Binding InstalledVersion}" FontSize="19" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="VERFÜGBARE VERSION" Style="{StaticResource FieldLabelStyle}" />
              <TextBlock Text="{Binding AvailableVersion, TargetNullValue='–'}" FontSize="19" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="DATENBANKSCHEMA" Style="{StaticResource FieldLabelStyle}" />
              <TextBlock Text="{Binding DatabaseSchemaVersion}" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitleStyle}">
                <Run Text="{Binding PendingMigrations, Mode=OneWay}" /><Run Text=" ausstehende Änderung(en)" />
              </TextBlock>
              <TextBlock Text="{Binding DatabaseSchemaHint}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="240"
                         Style="{StaticResource PageSubtitleStyle}"
                         Visibility="{Binding DatabaseSchemaHint, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="QUELLE" Style="{StaticResource FieldLabelStyle}" />
              <RadioButton Content="Updateablage im Firmennetz" GroupName="Updatequelle" Margin="0,2,0,0"
                           IsChecked="{Binding UseOnlineSource, Converter={StaticResource InverseBool}}" />
              <RadioButton Content="Veröffentlichungen im Internet" GroupName="Updatequelle" Margin="0,4,0,0"
                           IsChecked="{Binding UseOnlineSource}"
                           ToolTip="Fragt github.com nach der neuesten Version. Es werden keine Fuhrparkdaten übertragen." />
              <TextBlock Text="{Binding UpdatePath, TargetNullValue='keine Updateablage konfiguriert'}"
                         Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}"
                         Visibility="{Binding UseOnlineSource, Converter={StaticResource BoolToVisibility},
                                              ConverterParameter=Invert}" />
              <TextBlock Text="{Binding UpdateRepository}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Style="{StaticResource PageSubtitleStyle}"
                         Visibility="{Binding UseOnlineSource, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding CheckMessage}" Margin="0,6,0,0" Style="{StaticResource PageSubtitleStyle}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding DownloadProgress}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding DownloadProgress, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Ergebnis der Pruefsummenpruefung: Farbe ist nie die einzige Information,
             der Text nennt das Ergebnis ausdruecklich. -->
        <Border x:Name="ChecksumCard" Margin="0,0,0,12"
                Visibility="{Binding ChecksumMessage, Converter={StaticResource StringToVisibility}}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
              <Setter Property="Background" Value="{StaticResource CriticalBackgroundBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecksumValid}" Value="True">
                  <Setter Property="Background" Value="{StaticResource OkBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <!-- Noch nichts geladen: da ist nichts in Unordnung. -->
                <DataTrigger Binding="{Binding IsChecksumPending}" Value="True">
                  <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                  <Setter Property="Text" Value="PRÜFSUMME DES PAKETS: NICHT IN ORDNUNG" />
                  <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecksumValid}" Value="True">
                      <Setter Property="Text" Value="PRÜFSUMME DES PAKETS: IN ORDNUNG" />
                      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChecksumPending}" Value="True">
                      <Setter Property="Text" Value="PRÜFSUMME DES PAKETS: NOCH NICHT GEPRÜFT" />
                      <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ChecksumMessage}" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                Background="{StaticResource CriticalBackgroundBrush}"
                BorderBrush="{StaticResource CriticalBrush}"
                Visibility="{Binding IsMandatory, Converter={StaticResource BoolToVisibility}}">
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}" FontWeight="SemiBold"
                     Text="Diese Version muss aktualisiert werden, bevor die Anwendung weiter verwendet werden kann." />
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                Visibility="{Binding ReleaseNotes, Converter={StaticResource StringToVisibility}}">
          <StackPanel>
            <TextBlock Text="RELEASE NOTES" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
            <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" TextWrapping="Wrap" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                Visibility="{Binding MigrationProgress, Converter={StaticResource StringToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding MigrationProgress}" FontWeight="SemiBold" />
            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="UPDATEVERLAUF" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
        <DataGrid ItemsSource="{Binding History}" MaxHeight="280" Margin="0,0,0,14">
          <DataGrid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource TabellenZellenText}" />
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Gestartet" Binding="{Binding StartedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                Width="150" />
            <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="150" />
            <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName}" Width="140" />
            <DataGridTextColumn Header="Alte Version" Binding="{Binding OldApplicationVersion}" Width="120" />
            <DataGridTextColumn Header="Neue Version" Binding="{Binding NewApplicationVersion}" Width="120" />
            <DataGridTextColumn Header="DB alt" Binding="{Binding OldDatabaseVersion}" Width="100" />
            <DataGridTextColumn Header="DB neu" Binding="{Binding NewDatabaseVersion}" Width="100" />
            <DataGridTextColumn Header="Ergebnis" Binding="{Binding Outcome, Converter={StaticResource EnumToText}}"
                                Width="160" />
            <DataGridTextColumn Header="Fehler" Binding="{Binding ErrorMessage}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="DATENBANKVERSIONEN" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
        <DataGrid ItemsSource="{Binding DatabaseVersions}" MaxHeight="240">
          <DataGrid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource TabellenZellenText}" />
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Schemaversion" Binding="{Binding SchemaVersion}" Width="140" />
            <DataGridTextColumn Header="Angewendet am" Binding="{Binding AppliedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                Width="160" />
            <DataGridTextColumn Header="Computer" Binding="{Binding AppliedByComputer}" Width="150" />
            <DataGridTextColumn Header="Benutzer" Binding="{Binding AppliedByUserName}" Width="140" />
            <DataGridTextColumn Header="Letzte Migration" Binding="{Binding LastMigration}" Width="*" />
            <DataGridTextColumn Header="Aktuell" Binding="{Binding IsCurrent, Converter={StaticResource BoolToYesNo}}"
                                Width="90" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
