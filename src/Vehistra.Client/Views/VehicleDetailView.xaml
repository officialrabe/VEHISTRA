<UserControl x:Class="Vehistra.Client.Views.VehicleDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceAltBrush}">
  <UserControl.Resources>
    <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}" />
    <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Kopfbereich der Fahrzeugakte -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Header.LicensePlate}" FontSize="24" FontWeight="SemiBold" />
            <Border Style="{StaticResource BadgeStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceSunkenBrush}">
              <StackPanel Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding Header.StatusColorHex, Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding Header.StatusName}" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource BadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{StaticResource InactiveBackgroundBrush}"
                    Visibility="{Binding IsRetired, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="AUSGEMUSTERT" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource InactiveBrush}" />
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource PageSubtitleStyle}">
              <Run Text="Interne Nr. " /><Run Text="{Binding Header.InternalNumber, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="·" Margin="8,0" Style="{StaticResource PageSubtitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}">
              <Run Text="{Binding Header.Manufacturer, Mode=OneWay}" /><Run Text=" " /><Run
                Text="{Binding Header.Model, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="·" Margin="8,0" Style="{StaticResource PageSubtitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}">
              <Run Text="Fester Fahrer: " /><Run Text="{Binding Header.DriverName, Mode=OneWay,
                TargetNullValue='nicht zugewiesen'}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="{Binding Header.CurrentMileage, StringFormat=N0}" FontSize="17"
                         FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Kilometer" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,10,0"
                  Background="{Binding Header.InspectionWarning, Converter={StaticResource WarningLevelToBackground}}">
            <StackPanel>
              <TextBlock Text="{Binding Header.NextInspectionDue, StringFormat=dd.MM.yyyy,
                                       TargetNullValue='–'}"
                         FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{Binding Header.InspectionWarning, Converter={StaticResource WarningLevelToBrush}}" />
              <TextBlock Text="TÜV fällig" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,16,0">
            <StackPanel>
              <TextBlock Text="{Binding Header.OpenDamageCount}" FontSize="17" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="offene Schäden" Style="{StaticResource PageSubtitleStyle}"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <StackPanel>
            <Button Content="_Bearbeiten" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"
                    Command="{Binding EditCommand}"
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="_Aktualisieren" Margin="0,6,0,0" MinWidth="130" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Fehleranzeige -->
    <Border Grid.Row="1" Background="{StaticResource CriticalBackgroundBrush}" Padding="18,8"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
    </Border>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="{StaticResource SurfaceBrush}">

      <!-- ÜBERSICHT -->
      <TabItem Header="ÜBERSICHT">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
          <UniformGrid Columns="3">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
              <StackPanel>
                <TextBlock Text="STAMMDATEN" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <TextBlock Text="Interne Fahrzeugnummer" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.InternalNumber}" Style="{StaticResource DetailValue}" />
                <TextBlock Text="Kennzeichen" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.LicensePlate, TargetNullValue='–'}" Style="{StaticResource DetailValue}" />
                <TextBlock Text="FIN / VIN" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.Vin, TargetNullValue='–'}" Style="{StaticResource DetailValue}" />
                <TextBlock Text="Hersteller / Modell / Variante" Style="{StaticResource DetailLabel}" />
                <TextBlock Style="{StaticResource DetailValue}">
                  <Run Text="{Binding Vehicle.Manufacturer, Mode=OneWay}" /><Run Text=" " /><Run
                    Text="{Binding Vehicle.Model, Mode=OneWay}" /><Run Text=" " /><Run
                    Text="{Binding Vehicle.Variant, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="Baujahr / Erstzulassung" Style="{StaticResource DetailLabel}" />
                <TextBlock Style="{StaticResource DetailValue}">
                  <Run Text="{Binding Vehicle.BuildYear, Mode=OneWay, TargetNullValue='–'}" /><Run Text=" · " /><Run
                    Text="{Binding Vehicle.FirstRegistration, Mode=OneWay, StringFormat=dd.MM.yyyy,
                                   TargetNullValue='–'}" />
                </TextBlock>
                <TextBlock Text="HSN / TSN" Style="{StaticResource DetailLabel}" />
                <TextBlock Style="{StaticResource DetailValue}">
                  <Run Text="{Binding Vehicle.Hsn, Mode=OneWay, TargetNullValue='–'}" /><Run Text=" / " /><Run
                    Text="{Binding Vehicle.Tsn, Mode=OneWay, TargetNullValue='–'}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
              <StackPanel>
                <TextBlock Text="TECHNIK" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                <TextBlock Text="Kraftstoffart" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.FuelType, Converter={StaticResource EnumToText}}"
                           Style="{StaticResource DetailValue}" />
                <TextBlock Text="Getriebe" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.Transmission, Converter={StaticResource EnumToText}}"
                           Style="{StaticResource DetailValue}" />
                <TextBlock Text="Leistung" Style="{StaticResource DetailLabel}" />
                <TextBlock Style="{StaticResource DetailValue}">
                  <Run Text="{Binding Vehicle.PowerKw, Mode=OneWay, TargetNullValue='–'}" /><Run Text=" kW" />
                </TextBlock>
                <TextBlock Text="Farbe" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.Color, TargetNullValue='–'}" Style="{StaticResource DetailValue}" />
                <TextBlock Text="Sitzplätze" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding Vehicle.Seats, TargetNullValue='–'}" Style="{StaticResource DetailValue}" />
                <TextBlock Text="Einsatzbereiche" Style="{StaticResource DetailLabel}" />
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,10">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource BadgeStyle}" Margin="0,2,6,0"
                              Background="{StaticResource SurfaceSunkenBrush}">
                        <TextBlock Text="{Binding Name}" FontSize="11" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <StackPanel>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="KAUFMÄNNISCH" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                  <TextBlock Text="Kaufdatum / Kaufpreis" Style="{StaticResource DetailLabel}" />
                  <TextBlock Style="{StaticResource DetailValue}">
                    <Run Text="{Binding Vehicle.PurchaseDate, Mode=OneWay, StringFormat=dd.MM.yyyy,
                                        TargetNullValue='–'}" /><Run Text=" · " /><Run
                      Text="{Binding Vehicle.PurchasePrice, Mode=OneWay, StringFormat={}{0:N2} EUR,
                                     TargetNullValue='–'}" />
                  </TextBlock>
                  <TextBlock Text="Leasing" Style="{StaticResource DetailLabel}" />
                  <TextBlock Style="{StaticResource DetailValue}">
                    <Run Text="{Binding Vehicle.IsLeased, Mode=OneWay, Converter={StaticResource BoolToYesNo}}" /><Run
                      Text=" · " /><Run Text="{Binding Vehicle.LeasingCompany, Mode=OneWay, TargetNullValue='–'}" />
                  </TextBlock>
                  <TextBlock Text="Bemerkung" Style="{StaticResource DetailLabel}" />
                  <TextBlock Text="{Binding Vehicle.Comment, TargetNullValue='–'}" Style="{StaticResource DetailValue}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="AKTIONEN" Style="{StaticResource SectionTitleStyle}" FontSize="12" />
                  <Button Content="Status ändern" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          Command="{Binding ChangeStatusCommand}"
                          Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                  <Button Content="Festen Fahrer zuweisen" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          Command="{Binding AssignDriverCommand}"
                          Visibility="{Binding CanAssignDriver, Converter={StaticResource BoolToVisibility}}" />
                  <Button Content="Kilometerstand erfassen" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          Command="{Binding AddMileageCommand}"
                          Visibility="{Binding CanEditMileage, Converter={StaticResource BoolToVisibility}}" />
                  <Button Content="Kennzeichen zuweisen / anmelden" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          Command="{Binding AssignPlateCommand}"
                          Visibility="{Binding CanManageRegistration, Converter={StaticResource BoolToVisibility}}" />
                  <Button Content="Fahrzeug abmelden" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          Command="{Binding DeregisterCommand}"
                          Visibility="{Binding CanManageRegistration, Converter={StaticResource BoolToVisibility}}" />
                  <Button Content="Fahrzeug ausmustern" Style="{StaticResource DangerButtonStyle}"
                          HorizontalAlignment="Stretch" Command="{Binding RetireCommand}"
                          Visibility="{Binding CanRetire, Converter={StaticResource BoolToVisibility}}" />
                  <Button Content="Ausmusterung zurücknehmen" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                          Command="{Binding UndoRetirementCommand}"
                          Visibility="{Binding IsRetired, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </UniformGrid>
        </ScrollViewer>
      </TabItem>

      <!-- FAHRER -->
      <TabItem Header="FAHRER">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="Festen Fahrer _zuweisen" HorizontalAlignment="Left"
                    Command="{Binding AssignDriverCommand}"
                    Visibility="{Binding CanAssignDriver, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" ItemsSource="{Binding DriverAssignments}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fahrer" Binding="{Binding Driver.DisplayName}" Width="*" />
              <DataGridTextColumn Header="Von" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="110" />
              <DataGridTextColumn Header="Bis" Binding="{Binding ValidTo, StringFormat=dd.MM.yyyy,
                                                         TargetNullValue='aktuell'}" Width="110" />
              <DataGridTextColumn Header="Zugewiesen durch" Binding="{Binding AssignedByUserName}" Width="180" />
              <DataGridTextColumn Header="Bemerkung" Binding="{Binding Comment}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- TÜV -->
      <TabItem Header="TÜV">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Prüfung eintragen" HorizontalAlignment="Left" Command="{Binding AddInspectionCommand}"
                    Visibility="{Binding CanManageInspections, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" x:Name="InspectionGrid" ItemsSource="{Binding Inspections}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditInspectionCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=InspectionGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Art" Binding="{Binding Type, Converter={StaticResource EnumToText}}"
                                  Width="180" />
              <DataGridTextColumn Header="Prüfdatum" Binding="{Binding InspectionDate, StringFormat=dd.MM.yyyy}"
                                  Width="110" />
              <DataGridTextColumn Header="Nächste Fälligkeit" Binding="{Binding NextDueDate, StringFormat=dd.MM.yyyy}"
                                  Width="140" FontWeight="SemiBold" />
              <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result, Converter={StaticResource EnumToText}}"
                                  Width="160" />
              <DataGridTextColumn Header="Prüfstelle" Binding="{Binding TestCenter}" Width="180" />
              <DataGridTextColumn Header="Kilometerstand" Binding="{Binding Mileage, StringFormat=N0}" Width="120" />
              <DataGridTextColumn Header="Mängel" Binding="{Binding Defects}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- WARTUNG -->
      <TabItem Header="WARTUNG">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Wartung eintragen" HorizontalAlignment="Left" Command="{Binding AddMaintenanceCommand}"
                    Visibility="{Binding CanManageMaintenance, Converter={StaticResource BoolToVisibility}}" />
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding MaintenanceDue}" Margin="12,12,12,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="10,7"
                        Background="{Binding Level, Converter={StaticResource WarningLevelToBackground}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Level, Converter={StaticResource WarningLevelToText}}"
                               FontWeight="SemiBold" MinWidth="80"
                               Foreground="{Binding Level, Converter={StaticResource WarningLevelToBrush}}" />
                    <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" Margin="10,0,0,0" MinWidth="160" />
                    <TextBlock Text="{Binding Description}" Margin="10,0,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <DataGrid Grid.Row="2" Margin="12" ItemsSource="{Binding MaintenanceEntries}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Wartung" Binding="{Binding Rule.Name}" Width="200" />
              <DataGridTextColumn Header="Durchgeführt am" Binding="{Binding PerformedAt, StringFormat=dd.MM.yyyy}"
                                  Width="140" />
              <DataGridTextColumn Header="Kilometerstand" Binding="{Binding Mileage, StringFormat=N0}" Width="120" />
              <DataGridTextColumn Header="Nächste Fälligkeit" Binding="{Binding NextDueDate, StringFormat=dd.MM.yyyy}"
                                  Width="140" />
              <DataGridTextColumn Header="Nächste km" Binding="{Binding NextDueMileage, StringFormat=N0}" Width="110" />
              <DataGridTextColumn Header="Werkstatt" Binding="{Binding Workshop.Name}" Width="180" />
              <DataGridTextColumn Header="Kosten" Binding="{Binding Cost, StringFormat={}{0:N2} EUR}" Width="110" />
              <DataGridTextColumn Header="Bemerkung" Binding="{Binding Comment}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- SCHÄDEN -->
      <TabItem Header="SCHÄDEN">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Schaden melden" HorizontalAlignment="Left" Command="{Binding AddDamageCommand}"
                    Visibility="{Binding CanCreateDamage, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid x:Name="DamageGrid" Grid.Row="1" Margin="12" ItemsSource="{Binding Damages}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenDamageCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=DamageGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nummer" Binding="{Binding DamageNumber}" Width="130" />
              <DataGridTextColumn Header="Datum" Binding="{Binding OccurredAt, StringFormat=dd.MM.yyyy}" Width="110" />
              <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="2*" />
              <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryName}" Width="130" />
              <DataGridTemplateColumn Header="Priorität" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource BadgeStyle}"
                            Background="{Binding Priority, Converter={StaticResource DamagePriorityToBackground}}">
                      <TextBlock Text="{Binding Priority, Converter={StaticResource EnumToText}}" FontSize="11"
                                 Foreground="{Binding Priority, Converter={StaticResource DamagePriorityToBrush}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource BadgeStyle}"
                            Background="{Binding Status, Converter={StaticResource DamageStatusToBackground}}">
                      <TextBlock Text="{Binding Status, Converter={StaticResource EnumToText}}" FontSize="11"
                                 Foreground="{Binding Status, Converter={StaticResource DamageStatusToBrush}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Fahrbereit"
                                  Binding="{Binding IsDriveable, Converter={StaticResource BoolToYesNo}}" Width="100" />
              <DataGridTextColumn Header="Kosten" Binding="{Binding CostActual, StringFormat={}{0:N2} EUR}"
                                  Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- UNFÄLLE -->
      <TabItem Header="UNFÄLLE">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Unfall erfassen" HorizontalAlignment="Left" Command="{Binding AddAccidentCommand}"
                    Visibility="{Binding CanCreateAccident, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" x:Name="AccidentGrid" ItemsSource="{Binding Accidents}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenAccidentCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=AccidentGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nummer" Binding="{Binding AccidentNumber}" Width="130" />
              <DataGridTextColumn Header="Datum" Binding="{Binding OccurredAt, StringFormat=dd.MM.yyyy HH:mm}"
                                  Width="140" />
              <DataGridTextColumn Header="Ort" Binding="{Binding Location}" Width="2*" />
              <DataGridTextColumn Header="Art" Binding="{Binding Type, Converter={StaticResource EnumToText}}"
                                  Width="220" />
              <DataGridTextColumn Header="Polizei"
                                  Binding="{Binding PoliceInvolved, Converter={StaticResource BoolToYesNo}}"
                                  Width="90" />
              <DataGridTextColumn Header="Personenschaden"
                                  Binding="{Binding PersonalInjury, Converter={StaticResource BoolToYesNo}}"
                                  Width="140" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- WERKSTATT -->
      <TabItem Header="WERKSTATT">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Werkstattauftrag anlegen" HorizontalAlignment="Left"
                    Command="{Binding AddWorkshopOrderCommand}"
                    Visibility="{Binding CanManageWorkshop, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" x:Name="WorkshopGrid" ItemsSource="{Binding WorkshopOrders}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenWorkshopOrderCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=WorkshopGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Vorgang" Binding="{Binding OrderNumber}" Width="130" />
              <DataGridTextColumn Header="Werkstatt" Binding="{Binding WorkshopName}" Width="200" />
              <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedOn, StringFormat=dd.MM.yyyy}"
                                  Width="110" />
              <DataGridTextColumn Header="Termin" Binding="{Binding AppointmentDate, StringFormat=dd.MM.yyyy}"
                                  Width="110" />
              <DataGridTemplateColumn Header="Status" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource BadgeStyle}"
                            Background="{Binding Status, Converter={StaticResource WorkshopStatusToBackground}}">
                      <TextBlock Text="{Binding Status, Converter={StaticResource EnumToText}}" FontSize="11"
                                 Foreground="{Binding Status, Converter={StaticResource WorkshopStatusToBrush}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Tage in Werkstatt" Binding="{Binding DaysInWorkshop}" Width="130" />
              <DataGridTextColumn Header="Kosten netto" Binding="{Binding CostNet, StringFormat={}{0:N2} EUR}"
                                  Width="120" />
              <DataGridTextColumn Header="Rechnung" Binding="{Binding InvoiceNumber}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- DOKUMENTE -->
      <TabItem Header="DOKUMENTE">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Dokument hinzufügen" HorizontalAlignment="Left" Command="{Binding AddDocumentCommand}"
                    Visibility="{Binding CanManageDocuments, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" x:Name="DocumentGrid" ItemsSource="{Binding Documents}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenDocumentCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=DocumentGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Kategorie"
                                  Binding="{Binding Category, Converter={StaticResource EnumToText}}" Width="160" />
              <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*" />
              <DataGridTextColumn Header="Dateiname" Binding="{Binding OriginalFileName}" Width="220" />
              <DataGridTextColumn Header="Größe" Binding="{Binding FileSizeBytes, Converter={StaticResource FileSize}}"
                                  Width="100" />
              <DataGridTextColumn Header="Dokumentdatum" Binding="{Binding DocumentDate, StringFormat=dd.MM.yyyy}"
                                  Width="130" />
              <DataGridTextColumn Header="Hinzugefügt von" Binding="{Binding CreatedBy}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- KENNZEICHEN -->
      <TabItem Header="KENNZEICHEN">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <StackPanel Orientation="Horizontal">
              <Button Content="Kennzeichen _zuweisen / anmelden" Command="{Binding AssignPlateCommand}"
                      Visibility="{Binding CanManageRegistration, Converter={StaticResource BoolToVisibility}}" />
              <Button Content="_Abmelden" Margin="8,0,0,0" Command="{Binding DeregisterCommand}"
                      Visibility="{Binding CanManageRegistration, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding PlateHistory}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Kennzeichen" Binding="{Binding LicensePlate.Plate}" Width="150"
                                    FontWeight="SemiBold" />
                <DataGridTextColumn Header="Von" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="110" />
                <DataGridTextColumn Header="Bis" Binding="{Binding ValidTo, StringFormat=dd.MM.yyyy,
                                                           TargetNullValue='aktuell'}" Width="110" />
                <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="220" />
                <DataGridTextColumn Header="Zugewiesen durch" Binding="{Binding AssignedByUserName}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Registrations}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Vorgang"
                                    Binding="{Binding EventType, Converter={StaticResource EnumToText}}" Width="160" />
                <DataGridTextColumn Header="Angemeldet am" Binding="{Binding RegisteredAt, StringFormat=dd.MM.yyyy}"
                                    Width="140" />
                <DataGridTextColumn Header="Abgemeldet am" Binding="{Binding DeregisteredAt, StringFormat=dd.MM.yyyy}"
                                    Width="140" />
                <DataGridTextColumn Header="Kennzeichen" Binding="{Binding LicensePlate}" Width="140" />
                <DataGridTextColumn Header="Zulassungsstelle" Binding="{Binding RegistrationOffice}" Width="200" />
                <DataGridTextColumn Header="Grund" Binding="{Binding Reason}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- KILOMETER -->
      <TabItem Header="KILOMETER">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Kilometerstand erfassen" HorizontalAlignment="Left" Command="{Binding AddMileageCommand}"
                    Visibility="{Binding CanEditMileage, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" ItemsSource="{Binding MileageEntries}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Datum" Binding="{Binding RecordedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                  Width="150" />
              <DataGridTextColumn Header="Kilometerstand" Binding="{Binding Mileage, StringFormat=N0}" Width="140"
                                  FontWeight="SemiBold" />
              <DataGridTextColumn Header="Quelle" Binding="{Binding Source, Converter={StaticResource EnumToText}}"
                                  Width="180" />
              <DataGridTextColumn Header="Erfasst von" Binding="{Binding RecordedByUserName}" Width="180" />
              <DataGridTextColumn Header="Korrektur"
                                  Binding="{Binding IsCorrection, Converter={StaticResource BoolToYesNo}}"
                                  Width="100" />
              <DataGridTextColumn Header="Bemerkung" Binding="{Binding Comment}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- VERSICHERUNG -->
      <TabItem Header="VERSICHERUNG">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Versicherung hinzufügen" HorizontalAlignment="Left"
                    Command="{Binding AddInsuranceCommand}"
                    Visibility="{Binding CanManageInsurance, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" x:Name="InsuranceGrid" ItemsSource="{Binding Insurances}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditInsuranceCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=InsuranceGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Versicherung" Binding="{Binding Company}" Width="200" />
              <DataGridTextColumn Header="Art" Binding="{Binding Kind, Converter={StaticResource EnumToText}}"
                                  Width="140" />
              <DataGridTextColumn Header="Versicherungsnummer" Binding="{Binding PolicyNumber}" Width="180" />
              <DataGridTextColumn Header="Vertragsnummer" Binding="{Binding ContractNumber}" Width="160" />
              <DataGridTextColumn Header="Beginn" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="110" />
              <DataGridTextColumn Header="Ende" Binding="{Binding ValidTo, StringFormat=dd.MM.yyyy}" Width="110" />
              <DataGridTextColumn Header="Ansprechpartner" Binding="{Binding ContactPerson}" Width="180" />
              <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- SCHLÜSSEL -->
      <TabItem Header="SCHLÜSSEL">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource ToolbarStyle}">
            <Button Content="_Schlüssel hinzufügen" HorizontalAlignment="Left" Command="{Binding AddKeyCommand}"
                    Visibility="{Binding CanManageKeys, Converter={StaticResource BoolToVisibility}}" />
          </Border>
          <DataGrid Grid.Row="1" Margin="12" x:Name="KeyGrid" ItemsSource="{Binding Keys}">
            <DataGrid.InputBindings>
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditKeyCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=KeyGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Schlüsselnummer" Binding="{Binding KeyNumber}" Width="180" />
              <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="90" />
              <DataGridTextColumn Header="Aufbewahrungsort" Binding="{Binding StorageLocation}" Width="220" />
              <DataGridTextColumn Header="Ausgegeben an" Binding="{Binding IssuedToDriver.DisplayName}" Width="200" />
              <DataGridTextColumn Header="Ausgegeben seit" Binding="{Binding IssuedAt, StringFormat=dd.MM.yyyy}"
                                  Width="140" />
              <DataGridTextColumn Header="Zurückgegeben" Binding="{Binding ReturnedAt, StringFormat=dd.MM.yyyy}"
                                  Width="140" />
              <DataGridTextColumn Header="Bemerkung" Binding="{Binding Comment}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- HISTORIE -->
      <TabItem Header="HISTORIE">
        <DataGrid Margin="12" ItemsSource="{Binding Timeline}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat=dd.MM.yyyy HH:mm}"
                                Width="150" />
            <DataGridTextColumn Header="Bereich" Binding="{Binding Category}" Width="140" />
            <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="260" />
            <DataGridTextColumn Header="Alter Wert" Binding="{Binding OldValue}" Width="*" />
            <DataGridTextColumn Header="Neuer Wert" Binding="{Binding NewValue}" Width="*" />
            <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName}" Width="170" />
            <DataGridTextColumn Header="Verweis" Binding="{Binding Reference}" Width="170" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
