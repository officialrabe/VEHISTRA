<UserControl x:Class="Vehistra.Client.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:Vehistra.Domain.Enums;assembly=Vehistra.Domain"
             Background="{StaticResource SurfaceAltBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource ToolbarStyle}">
      <StackPanel Orientation="Horizontal">
        <Button Content="_Neuer Werkstattauftrag" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170"
                Command="{Binding CreateCommand}"
                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="_Bearbeiten" Margin="8,0,0,0" Command="{Binding EditCommand}"
                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
        <Button Content="Werkstattbericht _drucken" Command="{Binding PrintReportCommand}" MinWidth="180"
                Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Bericht zum ausgewählten Vorgang, mit Fahrzeug, Fahrer und Arbeiten" />
        <Button Content="B_lankoformular drucken" Margin="8,0,0,0" MinWidth="190"
                Command="{Binding PrintBlankReportCommand}"
                Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Leeres Werkstattformular zum Ausfüllen von Hand – ohne Auswahl eines Vorgangs" />
        <Button Content="_Fahrzeugakte" Margin="8,0,0,0" Command="{Binding OpenVehicleCommand}" />
        <Button Content="Export CSV" Margin="8,0,0,0" Command="{Binding ExportCommand}" CommandParameter="csv"
                Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="_Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="12,8">
      <StackPanel Orientation="Horizontal">
        <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                 ToolTip="Suche nach Vorgangs- oder Rechnungsnummer, Grund oder Fahrzeug" />
        <ComboBox Width="200" Margin="8,0,0,0" ItemsSource="{Binding Workshops}" DisplayMemberPath="Name"
                  SelectedItem="{Binding WorkshopFilter}" ToolTip="Werkstatt" />
        <ComboBox Width="180" Margin="8,0,0,0" ItemsSource="{Binding StatusValues}"
                  SelectedItem="{Binding StatusFilter}" ToolTip="Status">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumToText}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="nur offene" IsChecked="{Binding OnlyOpen}" Margin="14,0,0,0" VerticalAlignment="Center" />
        <CheckBox Content="Fahrzeug in Werkstatt" IsChecked="{Binding OnlyInWorkshop}" Margin="14,0,0,0"
                  VerticalAlignment="Center" />
        <CheckBox Content="{Binding LongStayFilterLabel}" IsChecked="{Binding OnlyLongStay}" Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  ToolTip="Fahrzeuge, die ungewöhnlich lange in der Werkstatt stehen. Die Frist stellen Sie unter Einstellungen ein." />
      </StackPanel>
    </Border>

    <DataGrid x:Name="OrderGrid" Grid.Row="2" Margin="12" ItemsSource="{Binding Orders}"
              SelectedItem="{Binding SelectedOrder}">
      <DataGrid.InputBindings>
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"
                      CommandParameter="{Binding SelectedItem, ElementName=OrderGrid}" />
      </DataGrid.InputBindings>

      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Bearbeiten" Command="{Binding EditCommand}" />
          <MenuItem Header="Werkstattbericht drucken" Command="{Binding PrintReportCommand}" />
          <Separator />
          <MenuItem Header="Fahrzeug abgegeben" Command="{Binding ChangeStatusCommand}"
                    CommandParameter="{x:Static enums:WorkshopOrderStatus.FahrzeugAbgegeben}" />
          <MenuItem Header="In Bearbeitung" Command="{Binding ChangeStatusCommand}"
                    CommandParameter="{x:Static enums:WorkshopOrderStatus.InBearbeitung}" />
          <MenuItem Header="Wartet auf Teile" Command="{Binding ChangeStatusCommand}"
                    CommandParameter="{x:Static enums:WorkshopOrderStatus.WartetAufTeile}" />
          <MenuItem Header="Fertig" Command="{Binding ChangeStatusCommand}"
                    CommandParameter="{x:Static enums:WorkshopOrderStatus.Fertig}" />
          <MenuItem Header="Abgeholt" Command="{Binding ChangeStatusCommand}"
                    CommandParameter="{x:Static enums:WorkshopOrderStatus.Abgeholt}" />
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Columns>
        <DataGridTextColumn Header="Vorgang" Binding="{Binding OrderNumber}" Width="130" FontWeight="SemiBold" />
        <DataGridTextColumn Header="Fahrzeug" Binding="{Binding VehicleDisplay}" Width="*" />
        <DataGridTextColumn Header="Werkstatt" Binding="{Binding WorkshopName}" Width="200" />
        <DataGridTextColumn Header="Fahrer" Binding="{Binding DriverName}" Width="160" />
        <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedOn, StringFormat=dd.MM.yyyy}" Width="110" />
        <DataGridTextColumn Header="Termin" Binding="{Binding AppointmentDate, StringFormat=dd.MM.yyyy}" Width="110" />
        <DataGridTemplateColumn Header="Status" Width="165">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Style="{StaticResource BadgeStyle}"
                      Background="{Binding Status, Converter={StaticResource WorkshopStatusToBackground}}">
                <TextBlock Text="{Binding Status, Converter={StaticResource EnumToText}}" FontSize="11"
                           Foreground="{Binding Status, Converter={StaticResource WorkshopStatusToBrush}}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Tage" Binding="{Binding DaysInWorkshop}" Width="70" />
        <DataGridTextColumn Header="Kosten netto" Binding="{Binding CostNet, StringFormat={}{0:N2} EUR}" Width="120" />
        <DataGridTextColumn Header="Rechnung" Binding="{Binding InvoiceNumber}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
