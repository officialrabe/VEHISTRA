<Window x:Class="Vehistra.ServerCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehistra – Serverprüfung" Height="800" Width="1060"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

  <DockPanel>

    <!-- Kopfbereich -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" Padding="28,20">
      <Grid>
        <StackPanel>
          <TextBlock Text="VEHISTRA" FontSize="17" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Serverprüfung – findet Probleme und erklärt, was zu tun ist"
                     FontSize="12" Foreground="#FFB9C4D0" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock Text="LSP Virtual Services" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="12" Foreground="#FF8C99A8" />
      </Grid>
    </Border>

    <!-- Fußzeile -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
      <Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" MaxWidth="420" />
          <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                     Text="Der Bericht enthält keine Passwörter und keine personenbezogenen Daten." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Bericht _kopieren" Command="{Binding CopyReportCommand}" Margin="0,0,8,0" />
          <Button Content="Bericht _speichern" Command="{Binding SaveReportCommand}" Margin="0,0,8,0" />
          <Button Content="_Logordner öffnen" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
          <Button Content="S_upport kontaktieren" Command="{Binding ContactSupportCommand}" Margin="0,0,8,0" />
          <Button Content="_Prüfung starten" Command="{Binding RunChecksCommand}"
                  Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                  MinWidth="160" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Margin="28,20,28,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Gesamtergebnis -->
      <Border Padding="18,14" BorderThickness="1"
              Background="{Binding OverallState, Converter={StaticResource StateBrush},
                                   ConverterParameter=background}"
              BorderBrush="{Binding OverallState, Converter={StaticResource StateBrush}}">
        <StackPanel Orientation="Horizontal">
          <Border Padding="10,4" CornerRadius="2" VerticalAlignment="Center"
                  Background="{Binding OverallState, Converter={StaticResource StateBrush}}">
            <TextBlock Text="{Binding SummaryCaption}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <TextBlock Text="{Binding SummaryText}" Margin="14,0,0,0" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="820" />
        </StackPanel>
      </Border>

      <!-- Hinweis vor dem ersten Lauf -->
      <Border Grid.Row="1" Margin="0,14,0,0" Padding="16,13" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              Visibility="{Binding HasRun, Converter={StaticResource BoolVisibility}, ConverterParameter=invert}">
        <StackPanel>
          <TextBlock Text="Was wird geprüft?" FontWeight="SemiBold" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                     Text="• Ist eine Serververbindung hinterlegt und wie meldet sich das Programm an?&#10;• Ist der Server im Netz erreichbar und ist der SQL-Server-Port offen?&#10;• Existiert die Fuhrparkdatenbank, ist ihre Struktur aktuell und darf gelesen und geschrieben werden?&#10;• Gibt es ein aktives Administratorkonto?&#10;• Sind Dokumenten-, Backup- und Updateordner erreichbar und beschreibbar?&#10;• Reicht der freie Speicherplatz auf dem Server?" />
        </StackPanel>
      </Border>

      <!-- Ergebnisliste -->
      <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Groups}" Margin="12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,18">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="12,10" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Background="{Binding State, Converter={StaticResource StateBrush},
                                                     ConverterParameter=background}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="110" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border VerticalAlignment="Top" Padding="8,3" CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Background="{Binding State, Converter={StaticResource StateBrush}}">
                              <TextBlock Text="{Binding StateCaption}" Foreground="White"
                                         FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                              <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" FontSize="12"
                                         Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                         Visibility="{Binding HintText,
                                                              Converter={StaticResource TextVisibility}}" />
                              <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FontSize="11"
                                         FontFamily="Consolas" Foreground="{StaticResource MutedBrush}"
                                         Margin="0,6,0,0"
                                         Visibility="{Binding TechnicalDetails,
                                                              Converter={StaticResource TextVisibility}}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Wartehinweis -->
      <Border Grid.RowSpan="3" Background="#99000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
        <Border Background="White" Padding="34,26" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Die Prüfung läuft …" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,0" HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Height="6" Width="260" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
      </Border>

    </Grid>
  </DockPanel>
</Window>
